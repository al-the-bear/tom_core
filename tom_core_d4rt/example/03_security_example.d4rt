# =============================================================================
# tom_core_d4rt example — Security bridge (tom_core_kernel)
#
# Demonstrates the security surface a DartScript author can call: the principal
# model (roles, entitlements, groups), the ACL access-control checks
# (entitlement / role / group access), bearer authentication, and the
# resource-role authorization registry + adapter that map a resource to an
# effective TomAuthState.
#
# Run it (prints real results):
#   dart run bin/d4rt.dart -run-replay example/03_security_example.d4rt
# Run it as a self-check (asserts, exit 0 on success):
#   dart run bin/d4rt.dart -run-replay example/03_security_example.d4rt -test
#
# Each statement is on a single line: the replay runner parses statements in
# isolation and does not reassemble multi-line expressions.
# =============================================================================

print('=== 03: Security bridge example ===');

# --- 1. The principal model ---------------------------------------------------
print('1. Principal model (roles, entitlements, groups):');
var role = TomRole(name: 'admin', entitlements: ['orders:read', 'orders:write']);
print('   - role: ' + role.name);
var entitlement = TomEntitlement(name: 'orders:read');
print('   - entitlement: ' + entitlement.name);
var group = TomGroup(name: 'staff');
print('   - group: ' + group.name);

# --- 2. ACL access controls ---------------------------------------------------
print('2. ACL access controls:');
var entAccess = TomEntitlementAccess(['orders:read', 'orders:write']);
print('   - entitlement access patterns: ' + entAccess.patterns.toString());
print('   - entitlement checkAccessibility(null): ' + entAccess.checkAccessibility(null).toString());
var roleAccess = TomRoleAccess(['admin', 'editor']);
print('   - role access roles: ' + roleAccess.roles.toString());
var groupAccess = TomGroupAccess(['staff']);
print('   - group access groups: ' + groupAccess.groups.toString());

# --- 3. Bearer authentication -------------------------------------------------
print('3. Bearer authentication:');
var bearer = TomBearerAuthentication();
print('   - constructed TomBearerAuthentication');
print('   - shared singleton resolves: ' + (TomBearerAuthentication.bearerAuthentication != null).toString());
print('   - token before login is null: ' + (TomBearerAuthentication.token == null).toString());

# --- 4. Resource-role authorization -------------------------------------------
# The registry maps a role name -> effective TomAuthState; the adapter maps a
# resource key -> role name, resolving each resource to an auth state.
print('4. Resource-role authorization:');
TomResourceRoleRegistry.reset();
TomResourceRoleRegistry.registerAll({'owner': TomAuthState.full, 'viewer': TomAuthState.read});
print('   - registry owner -> ' + TomResourceRoleRegistry.stateFor('owner').toString());
print('   - registry viewer -> ' + TomResourceRoleRegistry.stateFor('viewer').toString());
print('   - registry unknown role is null (denied): ' + (TomResourceRoleRegistry.stateFor('ghost') == null).toString());
var adapter = TomResourceRoleAdapter({'project.1': 'owner', 'project.2': 'viewer'});
var ownedState = adapter.resolveAuth('project.1');
print('   - adapter project.1 (owner) -> ' + ownedState.toString());
var viewerState = adapter.stateOf('project.2');
print('   - adapter project.2 (viewer) -> ' + viewerState.toString());
var noRoleState = adapter.resolveAuth('project.404');
print('   - adapter project.404 (no role) -> ' + noRoleState.toString());
TomResourceRoleRegistry.reset();

# =============================================================================
# Assertions (checked in -test mode)
# =============================================================================
verifyEquals(role.name, 'admin', 'role name preserved');
verifyEquals(entitlement.name, 'orders:read', 'entitlement name preserved');
verifyEquals(group.name, 'staff', 'group name preserved');
verifyEquals(entAccess.patterns[0], 'orders:read', 'entitlement access patterns preserved');
verifyNotNull(entAccess.checkAccessibility(null), 'entitlement checkAccessibility returns a bool');
verifyEquals(roleAccess.roles[1], 'editor', 'role access roles preserved');
verifyEquals(groupAccess.groups[0], 'staff', 'group access groups preserved');
verifyNotNull(bearer, 'TomBearerAuthentication constructed');
verifyEquals(TomBearerAuthentication.token, null, 'bearer token unset before login');
verifyEquals(ownedState, TomAuthState.full, 'owner resource resolves to full access');
verifyEquals(viewerState, TomAuthState.read, 'viewer resource resolves to read access');
verifyEquals(noRoleState, TomAuthState.none, 'resource with no role resolves to none');

testSummary();
