# =============================================================================
# Test: Query-DSL literals (4 tests)
# =============================================================================

var strLit = StringLiteral('ada');
verifyNotNull(strLit, 'StringLiteral created');
verifyEquals(strLit.operant1, 'ada', 'StringLiteral wraps its value');

var intLit = IntegerLiteral(42);
verifyEquals(intLit.operant1, 42, 'IntegerLiteral wraps its value');

# =============================================================================
# Test: Typed configuration class access (2 tests)
# Note: TomStringConfig/TomIntConfig eagerly resolve a configuration resource
# on construction and throw 'Obligatory resource ... not found' when no config
# is registered. They cannot be constructed bare in a replay script, so we only
# verify the class symbols are reachable.
# =============================================================================

verifyNotNull(TomStringConfig, 'TomStringConfig class exists');
verifyNotNull(TomIntConfig, 'TomIntConfig class exists');

# =============================================================================
# Test: Query-DSL operators + SQL dialect (connection-free)
# Build a predicate tree from literals and render it through the standard SQL
# dialect. Exercises the bridged operator constructors, their operand getters,
# and the generate()/analyze() traversals — none of which touch a datasource.
# =============================================================================

var dialect = TomStandardSqlDialect();
verifyNotNull(dialect, 'TomStandardSqlDialect created');

# Literals render through the dialect and describe themselves via analyze()
verifyContains(strLit.generate(dialect), 'ada', 'StringLiteral generate renders its value');
verifyContains(strLit.analyze(0), 'StringLiteral', 'StringLiteral analyze names the operator');
verifyContains(intLit.analyze(0), 'IntegerLiteral', 'IntegerLiteral analyze names the operator');

# Equality comparison over two literals
var eq = Eq(StringLiteral('name'), StringLiteral('ada'));
verifyNotNull(eq.operant1, 'Eq left operand present');
verifyNotNull(eq.operant2, 'Eq right operand present');
verifyContains(eq.analyze(0), 'Eq', 'Eq analyze names the operator');
verifyNotNull(eq.generate(dialect), 'Eq renders through the dialect');

# Less-than / greater-than comparisons over integer literals
var lt = Lt(IntegerLiteral(1), IntegerLiteral(2));
verifyContains(lt.analyze(0), 'Lt', 'Lt analyze names the operator');
var gt = Gt(IntegerLiteral(5), IntegerLiteral(3));
verifyContains(gt.analyze(0), 'Gt', 'Gt analyze names the operator');

# LIKE pattern match over string literals
var like = Like(StringLiteral('name'), StringLiteral('%ada%'));
verifyContains(like.analyze(0), 'Like', 'Like analyze names the operator');
verifyNotNull(like.generate(dialect), 'Like renders through the dialect');

# IN membership test with a list of choices
var inOp = In(IntegerLiteral(1), [IntegerLiteral(1), IntegerLiteral(2)]);
verifyNotNull(inOp.operant1, 'In left operand present');
verifyContains(inOp.analyze(0), 'In', 'In analyze names the operator');

# AND / OR conjunctions over predicate lists
var andOp = And([eq, lt]);
verifyContains(andOp.analyze(0), 'And', 'And analyze names the operator');
verifyNotNull(andOp.generate(dialect), 'And renders through the dialect');
var orOp = Or([gt, like]);
verifyContains(orOp.analyze(0), 'Or', 'Or analyze names the operator');

# NOT negation wrapping a predicate
var notOp = Not(eq);
verifyNotNull(notOp.operant1, 'Not wraps its operand');
verifyContains(notOp.analyze(0), 'Not', 'Not analyze names the operator');

# String-typed SQL dialect descriptor
var sqlDialect = TomSqlDialect('mariadb');
verifyEquals(sqlDialect.dataSourceType, 'mariadb', 'TomSqlDialect captures its datasource type');

# =============================================================================
# Test: Repository annotations (connection-free const value classes)
# These annotations are plain value objects describing persistence mapping; they
# carry no runtime connection and are safe to construct directly.
# =============================================================================

var dbTable = TomDbTable(datasource: 'main', table: 'users', primaryKeyField: 'id');
verifyEquals(dbTable.table, 'users', 'TomDbTable table name');
verifyEquals(dbTable.datasource, 'main', 'TomDbTable datasource name');
verifyEquals(dbTable.primaryKeyField, 'id', 'TomDbTable primary key field');

var dbColumn = TomDbColumn(columnName: 'user_name', isReadOnly: true);
verifyEquals(dbColumn.columnName, 'user_name', 'TomDbColumn column name');
verifyEquals(dbColumn.isReadOnly, true, 'TomDbColumn read-only flag');
verifyEquals(dbColumn.noLoad, false, 'TomDbColumn noLoad default');

var entityId = TomEntityId();
verifyNotNull(entityId, 'TomEntityId created');

var repoType = TomRepositoryType('mariadb');
verifyEquals(repoType.datasourceType, 'mariadb', 'TomRepositoryType datasource type');

var txAnno = TomTransactional(isReadOnly: true);
verifyEquals(txAnno.isReadOnly, true, 'TomTransactional read-only flag');
verifyEquals(txAnno.isTransactional, true, 'TomTransactional transactional default');

# =============================================================================
# Test: Transaction coordinator (per-isolate static manager)
# TomTransactionManager holds a single in-memory transaction per isolate; no
# datasource is required to open or inspect one.
# =============================================================================

verify(!TomTransactionManager.transactional, 'no transaction active before start');
verifyEquals(TomTransactionManager.getCurrentTransaction(), null, 'no current transaction before start');
TomTransactionManager.startTransaction();
verify(TomTransactionManager.transactional, 'transaction active after start');
var currentTx = TomTransactionManager.getCurrentTransaction();
verifyNotNull(currentTx, 'current transaction present after start');
verify(currentTx.isRunning, 'current transaction is running');
verifyEquals(currentTx.isReadOnly, false, 'transaction defaults to read-write');

# =============================================================================
# Test: Principal resource grants + delegation (C-6) — regenerated bridge
# surface (RCA6). Entities are no-arg constructible; every field is a named
# argument with a default. Statements stay on single lines (the replay runner
# parses each in isolation). Roles are declared in one Map-valued registerAll()
# call: RCC7 (tom_d4rt >=1.12.0) coerces a script Map whose values are bridged
# enums into a native Map<String, TomAuthState>, so the one-at-a-time register()
# the earlier bridge needed (RCA14) is no longer required.
# =============================================================================

var grant = TomPrincipalResourceGrant(principalId: 'u1', resourceKey: 'project.1', role: 'owner');
verifyEquals(grant.principalId, 'u1', 'grant principalId');
verifyEquals(grant.resourceKey, 'project.1', 'grant resourceKey');
verifyEquals(grant.role, 'owner', 'grant role');
verifyEquals(grant.id, -1, 'grant unsaved id defaults to -1');

TomResourceRoleRegistry.reset();
TomResourceRoleRegistry.registerAll({'owner': TomAuthState.full, 'viewer': TomAuthState.read});
verifyEquals(TomPrincipalResourceRoleResolver.registryStrength('owner', 'viewer'), 'owner', 'stronger role wins (full > read)');
verifyEquals(TomPrincipalResourceRoleResolver.registryStrength('viewer', 'owner'), 'owner', 'strength ordering is symmetric');
verifyEquals(TomPrincipalResourceRoleResolver.registryStrength('owner', 'ghost'), 'owner', 'known role beats unregistered');
TomResourceRoleRegistry.reset();

var delegation = TomPrincipalDelegation(delegatorId: 'a', delegateId: 'b', mode: 'share', resourceKey: 'project.1', role: 'viewer');
verifyEquals(delegation.delegatorId, 'a', 'delegation delegator');
verifyEquals(delegation.delegateId, 'b', 'delegation delegate');
verifyEquals(delegation.delegationMode.name, 'share', 'delegation mode parses to TomDelegationMode.share');
verifyEquals(delegation.revoked, false, 'delegation not revoked by default');

# =============================================================================
# Test: Remaining query-DSL operators + literals (RCE5 deepening)
# Same connection-free pattern as the operator section above: build predicates
# from literals, name them via analyze(), and render through the dialect.
# =============================================================================

# Additional literals — double and bool wrap their value and self-describe
var dblLit = DoubleLiteral(3.14);
verifyEquals(dblLit.operant1, 3.14, 'DoubleLiteral wraps its value');
verifyContains(dblLit.analyze(0), 'DoubleLiteral', 'DoubleLiteral analyze names the operator');
var boolLit = BoolLiteral(true);
verifyEquals(boolLit.operant1, true, 'BoolLiteral wraps its value');
verifyContains(boolLit.analyze(0), 'BoolLiteral', 'BoolLiteral analyze names the operator');

# Not-equal comparison
var neq = Neq(StringLiteral('name'), StringLiteral('ada'));
verifyContains(neq.analyze(0), 'Neq', 'Neq analyze names the operator');
verifyNotNull(neq.generate(dialect), 'Neq renders through the dialect');

# Greater-than-or-equal / less-than-or-equal over integer literals
var gte = Gte(IntegerLiteral(5), IntegerLiteral(3));
verifyContains(gte.analyze(0), 'Gte', 'Gte analyze names the operator');
var lte = Lte(IntegerLiteral(1), IntegerLiteral(2));
verifyContains(lte.analyze(0), 'Lte', 'Lte analyze names the operator');

# NOT LIKE pattern match
var notLike = NotLike(StringLiteral('name'), StringLiteral('%x%'));
verifyContains(notLike.analyze(0), 'NotLike', 'NotLike analyze names the operator');
verifyNotNull(notLike.generate(dialect), 'NotLike renders through the dialect');

# BETWEEN over a two-element bounds list
var between = Between(IntegerLiteral(5), [IntegerLiteral(1), IntegerLiteral(10)]);
verifyNotNull(between.operant1, 'Between left operand present');
verifyContains(between.analyze(0), 'Between', 'Between analyze names the operator');

# REGEXP pattern match
var regexp = Regexp(StringLiteral('name'), StringLiteral('^a.*'));
verifyContains(regexp.analyze(0), 'Regexp', 'Regexp analyze names the operator');

# IS NULL / IS NOT NULL null-predicate wrappers
var isNull = IsNull(StringLiteral('name'));
verifyNotNull(isNull.operant1, 'IsNull wraps its operand');
verifyContains(isNull.analyze(0), 'IsNull', 'IsNull analyze names the operator');
verifyNotNull(isNull.generate(dialect), 'IsNull renders through the dialect');
var isNotNull = IsNotNull(StringLiteral('name'));
verifyContains(isNotNull.analyze(0), 'IsNotNull', 'IsNotNull analyze names the operator');

# =============================================================================
# Test: MariaDbDatasource connection-free surface (RCK20)
# The driver's static port helpers and its unconnected-instance getters/setters
# need no server. The live connect/execute/transaction paths are covered by the
# DB-gated replay test_d4rt_tom_core_server_db.d4rt, which skips when no MariaDB
# is reachable — keeping the default run green everywhere.
# =============================================================================

verifyEquals(MariaDbDatasource.parsePort(3309), 3309, 'parsePort passes an int through');
verifyEquals(MariaDbDatasource.parsePort('3309'), 3309, 'parsePort parses a string port');
var normalizedSettings = MariaDbDatasource.normalizePort({'port': '3306'});
verifyEquals(normalizedSettings['port'], 3306, 'normalizePort folds a string port to int');

var freshDs = MariaDbDatasource();
verifyNotNull(freshDs, 'MariaDbDatasource constructed');
verifyEquals(freshDs.connected, false, 'a fresh datasource is not connected');
verifyEquals(freshDs.isOperational(), false, 'a fresh datasource is not operational');
verifyEquals(freshDs.port, -1, 'port is -1 until configured');
freshDs.host = '127.0.0.1';
verifyEquals(freshDs.host, '127.0.0.1', 'host setter round-trips');
freshDs.port = 3309;
verifyEquals(freshDs.port, 3309, 'port setter round-trips');
freshDs.databaseName = 'demo';
verifyEquals(freshDs.databaseName, 'demo', 'databaseName setter round-trips');

# =============================================================================
# Test: TomEndpointRouting static route-template rewrite (RCK20)
# shelfRoutePath is pure — it rewrites Tom's `{name}` path variables to
# shelf_router's `<name>` syntax (a route left with `{name}` silently 404s).
# The reflection/server-bound surface (scanClasses/initializeRouter over a live
# annotated pipeline) reflects over @tomService/@TomComponent classes, which the
# d4rt tool cannot bootstrap (no reflection init) — filed as RCL9.
# =============================================================================

verifyEquals(TomEndpointRouting.shelfRoutePath('/items/{id}/field-states'), '/items/<id>/field-states', 'shelfRoutePath rewrites a single path variable');
verifyEquals(TomEndpointRouting.shelfRoutePath('/projects/{pid}/tasks/{tid}'), '/projects/<pid>/tasks/<tid>', 'shelfRoutePath rewrites multiple path variables');
verifyEquals(TomEndpointRouting.shelfRoutePath('/health'), '/health', 'shelfRoutePath leaves a variable-free route unchanged');

# =============================================================================
# Test: TomQueryBuilder mixin builder methods (connection-free) (RCJ10)
# TomQueryBuilder is a MIXIN, so its builder methods can only be dispatched on a
# native holder that IS-A TomQueryBuilder (the bridge adapters validate the
# target as native). The only concrete holders — TomQuerySentenceCompiler and
# the repositories — reflect over their entity types at construction. Passing an
# EMPTY type list short-circuits that reflection (the analyser loop never runs),
# yielding a real TomQueryBuilder we can drive without a datasource. The builder
# methods construct the same operator nodes covered directly above; here we prove
# they are reachable *through the mixin API* and that the resulting tree renders
# through the standard SQL dialect. (Column-ref builders textF/intF/… and
# getColumnInformation/compileQuerySentence need reflected persistence info and
# stay uncovered — filed as RCL9.)
# =============================================================================

var qb = TomQuerySentenceCompiler([]);
verifyNotNull(qb, 'TomQuerySentenceCompiler constructed with an empty type list (no reflection)');

# Value/literal builders wrap raw values into operator nodes
var qbName = qb.text('ada');
verifyContains(qbName.analyze(0), 'StringLiteral', 'text() builds a StringLiteral operator');
verifyContains(qbName.generate(dialect), 'ada', 'text() operator renders its value through the dialect');
var qbAge = qb.intOp(42);
verifyContains(qbAge.analyze(0), 'IntegerLiteral', 'intOp() builds an IntegerLiteral operator');
var qbPrice = qb.doubleOp(3.14);
verifyContains(qbPrice.analyze(0), 'DoubleLiteral', 'doubleOp() builds a DoubleLiteral operator');
var qbFlag = qb.boolOp(true);
verifyContains(qbFlag.analyze(0), 'BoolLiteral', 'boolOp() builds a BoolLiteral operator');
var qbParam = qb.p('pName');
verifyNotNull(qbParam, 'p() builds a Parameter operator');

# Comparison builders combine operands into predicate nodes
var qbEq = qb.eq(qb.text('name'), qb.text('ada'));
verifyContains(qbEq.analyze(0), 'Eq', 'eq() builds an Eq predicate');
verifyNotNull(qbEq.generate(dialect), 'eq() predicate renders through the dialect');
var qbNeq = qb.neq(qb.text('name'), qb.text('bob'));
verifyContains(qbNeq.analyze(0), 'Neq', 'neq() builds a Neq predicate');
var qbLt = qb.lt(qb.intOp(1), qb.intOp(2));
verifyContains(qbLt.analyze(0), 'Lt', 'lt() builds a Lt predicate');
var qbLte = qb.lte(qb.intOp(1), qb.intOp(2));
verifyContains(qbLte.analyze(0), 'Lte', 'lte() builds a Lte predicate');
var qbGt = qb.gt(qb.intOp(5), qb.intOp(3));
verifyContains(qbGt.analyze(0), 'Gt', 'gt() builds a Gt predicate');
var qbGte = qb.gte(qb.intOp(5), qb.intOp(3));
verifyContains(qbGte.analyze(0), 'Gte', 'gte() builds a Gte predicate');

# Pattern builders
var qbLike = qb.like(qb.text('name'), qb.text('%ada%'));
verifyContains(qbLike.analyze(0), 'Like', 'like() builds a Like predicate');
verifyNotNull(qbLike.generate(dialect), 'like() predicate renders through the dialect');
var qbNotLike = qb.notLike(qb.text('name'), qb.text('%x%'));
verifyContains(qbNotLike.analyze(0), 'NotLike', 'notLike() builds a NotLike predicate');
var qbRegexp = qb.regexp(qb.text('name'), qb.text('^a.*'));
verifyContains(qbRegexp.analyze(0), 'Regexp', 'regexp() builds a Regexp predicate');

# Null predicates
var qbIsNull = qb.isNull(qb.text('name'));
verifyContains(qbIsNull.analyze(0), 'IsNull', 'isNull() builds an IsNull predicate');
verifyNotNull(qbIsNull.generate(dialect), 'isNull() predicate renders through the dialect');
var qbIsNotNull = qb.isNotNull(qb.text('name'));
verifyContains(qbIsNotNull.analyze(0), 'IsNotNull', 'isNotNull() builds an IsNotNull predicate');

# Membership / range builders take operand lists
var qbIn = qb.isIn(qb.intOp(1), [qb.intOp(1), qb.intOp(2)]);
verifyContains(qbIn.analyze(0), 'In', 'isIn() builds an In predicate');
var qbBetween = qb.between(qb.intOp(5), [qb.intOp(1), qb.intOp(10)]);
verifyContains(qbBetween.analyze(0), 'Between', 'between() builds a Between predicate');

# Grouping + boolean composition
var qbGroup = qb.group(qbEq);
verifyNotNull(qbGroup, 'group() wraps a predicate');
var qbNot = qb.not(qbEq);
verifyContains(qbNot.analyze(0), 'Not', 'not() builds a Not predicate');
var qbAnd = qb.and([qbEq, qbLt]);
verifyContains(qbAnd.analyze(0), 'And', 'and() builds an And predicate');
verifyNotNull(qbAnd.generate(dialect), 'and() predicate renders through the dialect');
var qbOr = qb.or([qbGt, qbLike]);
verifyContains(qbOr.analyze(0), 'Or', 'or() builds an Or predicate');

# A composite tree assembled purely through the builder API renders end-to-end
var qbComposite = qb.and([qbEq, qb.not(qbIsNull)]);
verifyContains(qbComposite.analyze(0), 'And', 'composite builder tree root is an And');
verifyNotNull(qbComposite.generate(dialect), 'a composite builder tree renders through the dialect');

# =============================================================================
# Summary
# =============================================================================

testSummary();
