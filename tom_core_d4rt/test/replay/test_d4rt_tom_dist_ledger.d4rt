# D4rt Test Suite - Tom Distributed Ledger Classes
# Run with: d4rt test_d4rt_tom_dist_ledger.d4rt -test
# Tests tom_dist_ledger bridged classes (enums, value carriers, retry/discovery).
#
# NOTE: rewritten 2026-06-15. The previous suite claimed FrameState and
# OperationState are "NOT exported/bridged" — but the current bridge DOES
# register both (plus HeartbeatErrorType and DLLogLevel). Extended to cover the
# value carriers and the re-exported tom_basics_network retry/discovery surface.


# =============================================================================
# Test: Enums (10 tests)
# =============================================================================

verifyEquals(HeartbeatErrorType.ledgerNotFound.name, 'ledgerNotFound', 'HeartbeatErrorType.ledgerNotFound');
verifyEquals(HeartbeatErrorType.values.length, 5, 'HeartbeatErrorType has 5 values');

# DLLogLevel has an extension overriding `.name` to upper-case (see doc); assert
# value identity + count to stay robust to extension-method resolution.
verifyNotNull(DLLogLevel.debug, 'DLLogLevel.debug');
verifyNotNull(DLLogLevel.error, 'DLLogLevel.error');
verifyEquals(DLLogLevel.values.length, 4, 'DLLogLevel has 4 values');

verifyEquals(FrameState.active.name, 'active', 'FrameState.active');
verifyEquals(FrameState.values.length, 4, 'FrameState has 4 values');

verifyEquals(OperationState.running.name, 'running', 'OperationState.running');
verifyEquals(OperationState.values.length, 4, 'OperationState has 4 values');

# =============================================================================
# Test: HeartbeatError carrier (2 tests)
# =============================================================================

var hbErr = HeartbeatError(type: HeartbeatErrorType.lockFailed, message: 'locked');
verifyEquals(hbErr.message, 'locked', 'HeartbeatError message');
verifyEquals(hbErr.type, HeartbeatErrorType.lockFailed, 'HeartbeatError type');

# =============================================================================
# Test: RetryConfig + default delays (3 tests)
# =============================================================================

var rc = RetryConfig();
verifyEquals(rc.retryDelaysMs.length, 5, 'RetryConfig default delays length');
verifyEquals(kDefaultRetryDelaysMs.length, 5, 'kDefaultRetryDelaysMs length');
verifyEquals(kDefaultRetryDelaysMs[0], 2000, 'kDefaultRetryDelaysMs first delay');

# =============================================================================
# Test: DiscoveredServer getters (3 tests)
# =============================================================================

var ds = DiscoveredServer(serverUrl: 'http://localhost:8080', status: {'service': 'ledger', 'port': 8080});
verifyEquals(ds.serverUrl, 'http://localhost:8080', 'DiscoveredServer serverUrl');
verifyEquals(ds.service, 'ledger', 'DiscoveredServer service getter');
verifyEquals(ds.port, 8080, 'DiscoveredServer port getter');

# =============================================================================
# Test: LedgerData (operation-state value carrier)
# =============================================================================

var ledgerData = LedgerData(operationId: 'op-1', initiatorId: 'init-1');
verifyEquals(ledgerData.operationId, 'op-1', 'LedgerData operationId');
verifyEquals(ledgerData.initiatorId, 'init-1', 'LedgerData initiatorId');
verifyEquals(ledgerData.aborted, false, 'LedgerData default aborted');
verifyNotNull(ledgerData.toJson(), 'LedgerData toJson');

# =============================================================================
# Test: TempResource (value carrier)
# =============================================================================

var tempRes = TempResource(path: '/tmp/x', owner: 1234, registeredAt: DateTime.now());
verifyEquals(tempRes.path, '/tmp/x', 'TempResource path');
verifyEquals(tempRes.owner, 1234, 'TempResource owner');

# =============================================================================
# Test: HeartbeatResult.noLedger factory + getters
# =============================================================================

var hbResult = HeartbeatResult.noLedger();
verifyNotNull(hbResult, 'HeartbeatResult.noLedger created');
verifyEquals(hbResult.ledgerExists, false, 'HeartbeatResult.noLedger ledgerExists false');

# =============================================================================
# Test: SyncResult (all-default value carrier + derived getters)
# =============================================================================

var syncResult = SyncResult();
verifyEquals(syncResult.operationFailed, false, 'SyncResult default operationFailed');
verifyEquals(syncResult.allSucceeded, true, 'SyncResult empty allSucceeded');
verifyEquals(syncResult.successfulCalls.length, 0, 'SyncResult empty successfulCalls');

# =============================================================================
# Test: OperationFailedInfo + OperationFailedException
# =============================================================================

var failInfo = OperationFailedInfo(operationId: 'op-2', failedAt: DateTime.now(), reason: 'crash');
verifyEquals(failInfo.operationId, 'op-2', 'OperationFailedInfo operationId');
verifyEquals(failInfo.reason, 'crash', 'OperationFailedInfo reason');

var failEx = OperationFailedException(failInfo);
verifyNotNull(failEx, 'OperationFailedException created');
verifyEquals(failEx.info.operationId, 'op-2', 'OperationFailedException holds its info');

# =============================================================================
# Test: Exceptions (RemoteLedgerException + tom_basics_network re-exports)
# =============================================================================

var remoteEx = RemoteLedgerException('upstream 500', statusCode: 500);
verifyEquals(remoteEx.message, 'upstream 500', 'RemoteLedgerException message');
verifyEquals(remoteEx.statusCode, 500, 'RemoteLedgerException statusCode');

var retryExhausted = RetryExhaustedException(lastError: 'boom', attempts: 4);
verifyEquals(retryExhausted.attempts, 4, 'RetryExhaustedException attempts');

var discFailed = DiscoveryFailedException('no ledger server');
verifyEquals(discFailed.message, 'no ledger server', 'DiscoveryFailedException message');

# =============================================================================
# Test: DiscoveryOptions (re-exported config value carrier)
# =============================================================================

var discOpts = DiscoveryOptions();
verifyEquals(discOpts.port, 19880, 'DiscoveryOptions default port');
verifyEquals(discOpts.scanSubnet, true, 'DiscoveryOptions default scanSubnet');

# =============================================================================
# Live-network classes: construction / value surface (RCK18)
#
# The network-gated classes (LedgerServer, RemoteLedgerClient, Ledger,
# RemoteOperation, LocalOperation, Call, CallLifecycle, ...) are reachable ONLY
# through async factories: LedgerServer.start, RemoteLedgerClient.connect /
# .discover, ledger.createOperation / .joinOperation, operation.startCall. A
# DRIVEN loopback fixture is impossible inside the d4rt replay harness:
#   (1) top-level `await` triggers the interpreter state-machine bug
#       ("Undefined variable"), failing the replay;
#   (2) an async factory assigned to a variable stays a raw Future -- it never
#       resolves to the LedgerServer/RemoteLedgerClient/Operation, so the object
#       cannot be bound to drive follow-up calls (empirically: a captured
#       LedgerServer.start(...) `is LedgerServer` == false);
#   (3) a `.then()` continuation runs AFTER testSummary() (its verifications are
#       never counted) and its async-void body re-triggers the interpreter bug.
# Empirically confirmed 2026-07-17 (see RCK18 notes). We therefore cover the
# SYNCHRONOUS construction + value surface of every network class that exposes
# one, and reachability-pin the async-only remainder.
# =============================================================================

# --- SpawnedCall: the full sync call-model surface (success path) ---
var scOk = SpawnedCall(callId: 'call-ok', description: 'a spawned call');
verifyEquals(scOk.callId, 'call-ok', 'SpawnedCall callId');
verifyEquals(scOk.description, 'a spawned call', 'SpawnedCall description');
verifyEquals(scOk.isCompleted, false, 'SpawnedCall not completed at start');
verifyEquals(scOk.isSuccess, false, 'SpawnedCall not success at start');
verifyEquals(scOk.isFailed, false, 'SpawnedCall not failed at start');
verifyEquals(scOk.isCancelled, false, 'SpawnedCall not cancelled at start');
verifyEquals(scOk.resultOrNull, null, 'SpawnedCall resultOrNull null before complete');
verifyEquals(scOk.resultOr(-1), -1, 'SpawnedCall resultOr default before complete');
verifyEquals(scOk.kill(), false, 'SpawnedCall kill() false with no process');
scOk.complete(42);
verifyEquals(scOk.isCompleted, true, 'SpawnedCall completed after complete()');
verifyEquals(scOk.isSuccess, true, 'SpawnedCall success after complete()');
verifyEquals(scOk.isFailed, false, 'SpawnedCall not failed after complete()');
verifyEquals(scOk.result, 42, 'SpawnedCall result after complete()');
verifyEquals(scOk.resultOrNull, 42, 'SpawnedCall resultOrNull after complete()');
verifyEquals(scOk.resultOr(-1), 42, 'SpawnedCall resultOr returns result after complete()');

# --- SpawnedCall: failure path ---
var scFail = SpawnedCall(callId: 'call-fail');
scFail.fail('boom');
verifyEquals(scFail.isCompleted, true, 'failed SpawnedCall isCompleted');
verifyEquals(scFail.isSuccess, false, 'failed SpawnedCall not success');
verifyEquals(scFail.isFailed, true, 'failed SpawnedCall isFailed');
verifyEquals(scFail.error, 'boom', 'failed SpawnedCall error');
verifyEquals(scFail.resultOr(-7), -7, 'failed SpawnedCall resultOr default');
verifyEquals(scFail.resultOrNull, null, 'failed SpawnedCall resultOrNull null');

# --- CallFrame: value carrier + setter + json round-trip + staleness ---
var cf = CallFrame(participantId: 'p1', callId: 'c1', pid: 4321, startTime: DateTime.now());
verifyEquals(cf.participantId, 'p1', 'CallFrame participantId');
verifyEquals(cf.callId, 'c1', 'CallFrame callId');
verifyEquals(cf.pid, 4321, 'CallFrame pid');
verifyEquals(cf.failOnCrash, true, 'CallFrame default failOnCrash');
verifyEquals(cf.state, FrameState.active, 'CallFrame default state active');
verifyEquals(cf.isStale(timeoutMs: 100000), false, 'fresh CallFrame not stale within 100s');
cf.state = FrameState.crashed;
verifyEquals(cf.state, FrameState.crashed, 'CallFrame state setter');
var cfJson = cf.toJson();
verifyNotNull(cfJson, 'CallFrame toJson');
var cf2 = CallFrame.fromJson(cfJson);
verifyEquals(cf2.callId, 'c1', 'CallFrame.fromJson callId round-trip');
verifyEquals(cf2.pid, 4321, 'CallFrame.fromJson pid round-trip');
verifyEquals(cf2.state, FrameState.crashed, 'CallFrame.fromJson state round-trip');

# --- LocalLedger: sync construction (creates dirs + starts global heartbeat
#     timer), value surface, and dispose() (cancels the timer). Real IO against
#     a self-contained temp fixture. ---
var llRoot = TomFs.tempDir(prefix: 'rck18_localledger_');
var localLedger = LocalLedger(basePath: llRoot, participantId: 'p-local');
verifyEquals(localLedger.participantId, 'p-local', 'LocalLedger participantId');
verifyEquals(localLedger.basePath, llRoot, 'LocalLedger basePath');
verifyEquals(localLedger.maxBackups, 20, 'LocalLedger default maxBackups');
verifyEquals(localLedger.heartbeatInterval.inSeconds, 5, 'LocalLedger default heartbeatInterval 5s');
verifyEquals(localLedger.staleThreshold.inSeconds, 15, 'LocalLedger default staleThreshold 15s');
verifyEquals(localLedger.lockTimeout.inSeconds, 2, 'LocalLedger default lockTimeout 2s');
verify(TomFs.exists(llRoot + '/backup'), 'LocalLedger created backup dir on construction');
localLedger.dispose();
TomFs.delete(llRoot, recursive: true);

# --- RemoteLedgerClient: sync construction (inert HttpClient, no connect),
#     value surface, and dispose(). ---
var remoteClient = RemoteLedgerClient(serverUrl: 'http://localhost:19880', participantId: 'p-remote');
verifyEquals(remoteClient.serverUrl, 'http://localhost:19880', 'RemoteLedgerClient serverUrl');
verifyEquals(remoteClient.participantId, 'p-remote', 'RemoteLedgerClient participantId');
verifyEquals(remoteClient.maxBackups, 20, 'RemoteLedgerClient default maxBackups');
verifyEquals(remoteClient.heartbeatInterval.inSeconds, 5, 'RemoteLedgerClient default heartbeatInterval 5s');
verifyEquals(remoteClient.staleThreshold.inSeconds, 15, 'RemoteLedgerClient default staleThreshold 15s');
remoteClient.dispose();

# --- Callback carriers: sync construction (default ctor + named factories) ---
var ledgerCb = LedgerCallback();
verifyNotNull(ledgerCb, 'LedgerCallback default construction');
var opCb = OperationCallback();
verifyNotNull(opCb, 'OperationCallback default construction');
var opCbFail = OperationCallback.onFailure((op, info) { });
verifyNotNull(opCbFail.onFailure, 'OperationCallback.onFailure factory stores callback');
var callCb = CallCallback();
verifyNotNull(callCb, 'CallCallback default construction');
var callCbCleanup = CallCallback.cleanup(() { });
verifyNotNull(callCbCleanup.onCleanup, 'CallCallback.cleanup factory stores callback');

# --- OperationHelper: static poll builders return a closure synchronously
#     (no IO until the returned function is later invoked). ---
var pollFileFn = OperationHelper.pollFile(path: '/nonexistent/rck18.json');
verifyNotNull(pollFileFn, 'OperationHelper.pollFile returns a poll function');
var pollUntilFn = OperationHelper.pollUntil(check: () { return null; });
verifyNotNull(pollUntilFn, 'OperationHelper.pollUntil returns a poll function');
var pollFilesFn = OperationHelper.pollFiles(paths: ['/nonexistent/a.json']);
verifyNotNull(pollFilesFn, 'OperationHelper.pollFiles returns a poll function');

# --- CleanupHandler: process-global singleton + register/unregister; dispose()
#     cancels the installed SIGINT/SIGTERM subscriptions so the replay exits. ---
var cleanup = CleanupHandler.instance;
verifyNotNull(cleanup, 'CleanupHandler.instance singleton');
var cleanupId = cleanup.register(() { });
verifyNotNull(cleanupId, 'CleanupHandler.register returns an id');
cleanup.unregister(cleanupId);
cleanup.dispose();

# =============================================================================
# Async-only classes: reachability pins (driven behaviour requires a live
# network / async factory, impossible in-replay -- see the RCK18 note above).
# =============================================================================

verifyNotNull(Ledger, 'Ledger class exists');
verifyNotNull(LocalLedger, 'LocalLedger class exists');
verifyNotNull(RemoteLedgerClient, 'RemoteLedgerClient class exists');
verifyNotNull(ServerDiscovery, 'ServerDiscovery class exists');
verifyNotNull(LedgerServer, 'LedgerServer class exists');
verifyNotNull(Operation, 'Operation class exists');
verifyNotNull(LocalOperation, 'LocalOperation class exists');
verifyNotNull(RemoteOperation, 'RemoteOperation class exists');
verifyNotNull(CallLifecycle, 'CallLifecycle class exists');
verifyNotNull(Call, 'Call class exists');
verifyNotNull(SpawnedCall, 'SpawnedCall class exists');
verifyNotNull(OperationHelper, 'OperationHelper class exists');
verifyNotNull(CleanupHandler, 'CleanupHandler class exists');

# =============================================================================
# Summary
# =============================================================================

testSummary();
