# D4rt Test Suite - Tom Distributed Ledger Classes
# Run with: d4rt test_d4rt_tom_dist_ledger.d4rt -test
# Tests tom_dist_ledger bridged classes (enums, value carriers, retry/discovery).
#
# NOTE: rewritten 2026-06-15. The previous suite claimed FrameState and
# OperationState are "NOT exported/bridged" — but the current bridge DOES
# register both (plus HeartbeatErrorType and DLLogLevel). Extended to cover the
# value carriers and the re-exported tom_basics_network retry/discovery surface.


# =============================================================================
# Test: Enums (10 tests)
# =============================================================================

verifyEquals(HeartbeatErrorType.ledgerNotFound.name, 'ledgerNotFound', 'HeartbeatErrorType.ledgerNotFound');
verifyEquals(HeartbeatErrorType.values.length, 5, 'HeartbeatErrorType has 5 values');

# DLLogLevel has an extension overriding `.name` to upper-case (see doc); assert
# value identity + count to stay robust to extension-method resolution.
verifyNotNull(DLLogLevel.debug, 'DLLogLevel.debug');
verifyNotNull(DLLogLevel.error, 'DLLogLevel.error');
verifyEquals(DLLogLevel.values.length, 4, 'DLLogLevel has 4 values');

verifyEquals(FrameState.active.name, 'active', 'FrameState.active');
verifyEquals(FrameState.values.length, 4, 'FrameState has 4 values');

verifyEquals(OperationState.running.name, 'running', 'OperationState.running');
verifyEquals(OperationState.values.length, 4, 'OperationState has 4 values');

# =============================================================================
# Test: HeartbeatError carrier (2 tests)
# =============================================================================

var hbErr = HeartbeatError(type: HeartbeatErrorType.lockFailed, message: 'locked');
verifyEquals(hbErr.message, 'locked', 'HeartbeatError message');
verifyEquals(hbErr.type, HeartbeatErrorType.lockFailed, 'HeartbeatError type');

# =============================================================================
# Test: RetryConfig + default delays (3 tests)
# =============================================================================

var rc = RetryConfig();
verifyEquals(rc.retryDelaysMs.length, 5, 'RetryConfig default delays length');
verifyEquals(kDefaultRetryDelaysMs.length, 5, 'kDefaultRetryDelaysMs length');
verifyEquals(kDefaultRetryDelaysMs[0], 2000, 'kDefaultRetryDelaysMs first delay');

# =============================================================================
# Test: DiscoveredServer getters (3 tests)
# =============================================================================

var ds = DiscoveredServer(serverUrl: 'http://localhost:8080', status: {'service': 'ledger', 'port': 8080});
verifyEquals(ds.serverUrl, 'http://localhost:8080', 'DiscoveredServer serverUrl');
verifyEquals(ds.service, 'ledger', 'DiscoveredServer service getter');
verifyEquals(ds.port, 8080, 'DiscoveredServer port getter');

# =============================================================================
# Test: LedgerData (operation-state value carrier)
# =============================================================================

var ledgerData = LedgerData(operationId: 'op-1', initiatorId: 'init-1');
verifyEquals(ledgerData.operationId, 'op-1', 'LedgerData operationId');
verifyEquals(ledgerData.initiatorId, 'init-1', 'LedgerData initiatorId');
verifyEquals(ledgerData.aborted, false, 'LedgerData default aborted');
verifyNotNull(ledgerData.toJson(), 'LedgerData toJson');

# =============================================================================
# Test: TempResource (value carrier)
# =============================================================================

var tempRes = TempResource(path: '/tmp/x', owner: 1234, registeredAt: DateTime.now());
verifyEquals(tempRes.path, '/tmp/x', 'TempResource path');
verifyEquals(tempRes.owner, 1234, 'TempResource owner');

# =============================================================================
# Test: HeartbeatResult.noLedger factory + getters
# =============================================================================

var hbResult = HeartbeatResult.noLedger();
verifyNotNull(hbResult, 'HeartbeatResult.noLedger created');
verifyEquals(hbResult.ledgerExists, false, 'HeartbeatResult.noLedger ledgerExists false');

# =============================================================================
# Test: SyncResult (all-default value carrier + derived getters)
# =============================================================================

var syncResult = SyncResult();
verifyEquals(syncResult.operationFailed, false, 'SyncResult default operationFailed');
verifyEquals(syncResult.allSucceeded, true, 'SyncResult empty allSucceeded');
verifyEquals(syncResult.successfulCalls.length, 0, 'SyncResult empty successfulCalls');

# =============================================================================
# Test: OperationFailedInfo + OperationFailedException
# =============================================================================

var failInfo = OperationFailedInfo(operationId: 'op-2', failedAt: DateTime.now(), reason: 'crash');
verifyEquals(failInfo.operationId, 'op-2', 'OperationFailedInfo operationId');
verifyEquals(failInfo.reason, 'crash', 'OperationFailedInfo reason');

var failEx = OperationFailedException(failInfo);
verifyNotNull(failEx, 'OperationFailedException created');
verifyEquals(failEx.info.operationId, 'op-2', 'OperationFailedException holds its info');

# =============================================================================
# Test: Exceptions (RemoteLedgerException + tom_basics_network re-exports)
# =============================================================================

var remoteEx = RemoteLedgerException('upstream 500', statusCode: 500);
verifyEquals(remoteEx.message, 'upstream 500', 'RemoteLedgerException message');
verifyEquals(remoteEx.statusCode, 500, 'RemoteLedgerException statusCode');

var retryExhausted = RetryExhaustedException(lastError: 'boom', attempts: 4);
verifyEquals(retryExhausted.attempts, 4, 'RetryExhaustedException attempts');

var discFailed = DiscoveryFailedException('no ledger server');
verifyEquals(discFailed.message, 'no ledger server', 'DiscoveryFailedException message');

# =============================================================================
# Test: DiscoveryOptions (re-exported config value carrier)
# =============================================================================

var discOpts = DiscoveryOptions();
verifyEquals(discOpts.port, 19880, 'DiscoveryOptions default port');
verifyEquals(discOpts.scanSubnet, true, 'DiscoveryOptions default scanSubnet');

# =============================================================================
# Test: Runtime entry points exist (integration-only: server/socket/call model)
# =============================================================================

verifyNotNull(Ledger, 'Ledger class exists');
verifyNotNull(LocalLedger, 'LocalLedger class exists');
verifyNotNull(RemoteLedgerClient, 'RemoteLedgerClient class exists');
verifyNotNull(ServerDiscovery, 'ServerDiscovery class exists');

# =============================================================================
# Summary
# =============================================================================

testSummary();
