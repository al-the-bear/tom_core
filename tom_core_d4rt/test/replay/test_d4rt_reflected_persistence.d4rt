# D4rt Test Suite - Reflected Persistence Bootstrap (RCL7)
# Run with: d4rt -run-replay test_d4rt_reflected_persistence.d4rt -test
#
# Proves the d4rt tool bootstraps tomReflector's registry at boot (via the
# generated initializeReflection(), called in d4rtMain). Before RCL7 the registry
# was empty and EVERY tomReflector.reflectType() threw, so the reflection-backed
# server surfaces (the annotation analyzer, the datasource row mapper, the
# endpoint pipeline) could not run from a d4rt script. Each assertion below would
# fail with "not in tomReflector" if the bootstrap were absent — so a green run
# is the proof the gap (RCJ9 → RCL7) is closed.


# =============================================================================
# Test: tomReflector resolves the reflected demo entity
# The load-bearing bootstrap proof: reflectType() over a registered type returns
# a mirror instead of throwing. An empty registry throws here.
# =============================================================================

var mirror = tomReflector.reflectType(D4rtDemoTaskRecord);
verifyNotNull(mirror, 'tomReflector.reflectType(D4rtDemoTaskRecord) resolves a mirror');

# =============================================================================
# Test: the demo entity constructs and its columns round-trip
# The bridged reflected entity is constructable and its typed nullable fields
# read back the values written (id stays null until first persisted).
# =============================================================================

var task = D4rtDemoTaskRecord();
verifyNotNull(task, 'D4rtDemoTaskRecord constructs via bridge');
verify(task.id == null, 'D4rtDemoTaskRecord.id is null before first insert');

task.title = 'write RCL7';
task.priority = 7;
task.done = false;
verifyEquals(task.title, 'write RCL7', 'D4rtDemoTaskRecord.title round-trips');
verifyEquals(task.priority, 7, 'D4rtDemoTaskRecord.priority round-trips');
verifyEquals(task.done, false, 'D4rtDemoTaskRecord.done round-trips');

# =============================================================================
# Test: the annotation analyzer resolves the entity's persistence metadata
# analysePersistentType() drives the exact reflection path the CRUD repository
# and datasource mapper use — mirror lookup + @TomDbTable + @TomDbColumn scan.
# This is the definitive positive proof reflection is live (empty registry throws
# TomAnnotationAnalyzerException here).
# =============================================================================

var info = TomAnnotationAnalyzer.analysePersistentType(D4rtDemoTaskRecord);
verifyNotNull(info, 'analysePersistentType(D4rtDemoTaskRecord) resolves metadata');
verifyNotNull(info.classMirror, 'persistence info carries the class mirror');
verifyEquals(info.table.table, 'd4rt_demo_task', '@TomDbTable table name resolved');
verifyEquals(info.table.datasource, 'd4rt_demo', '@TomDbTable datasource resolved');
verifyEquals(info.table.primaryKeyField, 'id', '@TomDbTable primary key field resolved');
verifyLength(info.columnInfo, 4, 'four @TomDbColumn columns resolved (id, title, priority, done)');

# =============================================================================
# Test: a concrete TomSqlDatasourceRepository subclass runs reflection at construct
# The repository constructor resolves its entity's persistence metadata by
# reflection FIRST, then looks up the 'd4rt_demo' data source — which is not
# registered here, so it throws "No datasource information obtainable ... for
# class D4rtDemoTaskRecord". Reaching that datasource-stage error is only possible
# once the reflection stage (analysePersistentType inside the constructor) has
# succeeded, so this proves the reflected-repository path is bridged and its
# reflection bootstrap is live. (The positive metadata proof is the block above.)
# =============================================================================

verifyThrows(() => D4rtDemoTaskRepository(), 'D4rtDemoTaskRepository construction runs reflection then reaches the data-source lookup');

# =============================================================================
# Summary
# =============================================================================

testSummary();
