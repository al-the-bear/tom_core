# =============================================================================
# Test: Observable boxed scalars (8 tests)
# =============================================================================

var boxedString = TomString('ada');
verifyNotNull(boxedString, 'TomString created');
verifyEquals(boxedString.get(), 'ada', 'TomString.get returns initial value');
verifyEquals(boxedString.isNull, false, 'TomString is not null');

var boxedInt = TomInt(42);
verifyEquals(boxedInt.get(), 42, 'TomInt.get returns initial value');

var boxedBool = TomBool(true);
verifyEquals(boxedBool.get(), true, 'TomBool.get returns initial value');

boxedString.set('lovelace');
verifyEquals(boxedString.get(), 'lovelace', 'TomString.set updates value');

