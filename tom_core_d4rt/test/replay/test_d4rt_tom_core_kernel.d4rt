# Test: ACL access controls (§17 security) (12 tests)
# =============================================================================

var entAccess = TomEntitlementAccess(['orders:read', 'orders:write']);
verifyNotNull(entAccess, 'TomEntitlementAccess constructed');
verifyEquals(entAccess.patterns[0], 'orders:read', 'entitlement patterns preserved');
verifyNotNull(entAccess.checkAccessibility(null), 'entitlement checkAccessibility(null) returns a bool');
verifyNotNull(entAccess.resolveAuthState(null), 'entitlement resolveAuthState(null) returns an auth state');

var roleAccess = TomRoleAccess(['admin', 'editor']);
verifyNotNull(roleAccess, 'TomRoleAccess constructed');
verifyEquals(roleAccess.roles[1], 'editor', 'role patterns preserved');
verifyNotNull(roleAccess.checkAccessibility(null), 'role checkAccessibility(null) returns a bool');
verifyNotNull(roleAccess.resolveAuthState(null), 'role resolveAuthState(null) returns an auth state');

var groupAccess = TomGroupAccess(['staff']);
verifyNotNull(groupAccess, 'TomGroupAccess constructed');
verifyEquals(groupAccess.groups[0], 'staff', 'group patterns preserved');
verifyNotNull(groupAccess.checkAccessibility(null), 'group checkAccessibility(null) returns a bool');
verifyNotNull(groupAccess.resolveAuthState(null), 'group resolveAuthState(null) returns an auth state');

