verifyEquals(textProvider.getText('greeting'), 'hello', 'text resource value resolved');
verifyEquals(textProvider.getTextOrNull('missing'), null, 'getTextOrNull returns null for absent key');

var configProvider = TomConfigResourceProvider.from({'db.host': 'localhost'});
verifyNotNull(configProvider, 'TomConfigResourceProvider.from constructed');
verifyEquals(configProvider.exists('db.host'), true, 'config resource exists');

