# D4rt Test Suite - Tom Doc Specs Classes
# Run with: d4rt test_d4rt_tom_doc_specs.d4rt -test
# Tests tom_doc_specs bridged classes (schema model, validation, enums).
# NOTE: Uses single-line syntax for D4rt parser compatibility.
# Covers all 31 registered bridges. The connection-free surface is asserted
# directly; the IO/scan surfaces (SchemaLoader.loadSync, SchemaResolver.resolve*
# /resolveByDocumentFilename*, SchemaDiscovery.listSchemas*, and the DocSpecs
# scan/loadSchema/validate facade) are exercised over a live self-contained
# fixture written to a temp dir (RCK17, see the final section). The only member
# left reachability-pinned is AiValidator — an abstract LLM-injection interface
# that has no invokable behaviour without a concrete implementation.


# =============================================================================
# Test: ValidationError carrier + default category (4 tests)
# =============================================================================

var err = ValidationError(message: 'bad', lineNumber: 5, sectionId: 's1');
verifyNotNull(err, 'ValidationError created');
verifyEquals(err.message, 'bad', 'ValidationError message');
verifyEquals(err.lineNumber, 5, 'ValidationError lineNumber');
verifyEquals(err.category, ValidationErrorCategory.general, 'ValidationError default category');

# =============================================================================
# Test: ValidationErrorCategory enum (2 tests)
# =============================================================================

verifyEquals(ValidationErrorCategory.general.name, 'general', 'ValidationErrorCategory.general name');
verifyEquals(ValidationErrorCategory.values.length, 12, 'ValidationErrorCategory has 12 values');

# =============================================================================
# Test: SchemaSource enum (3 tests)
# =============================================================================

verifyEquals(SchemaSource.local.name, 'local', 'SchemaSource.local name');
verifyEquals(SchemaSource.builtin.name, 'builtin', 'SchemaSource.builtin name');
verifyEquals(SchemaSource.values.length, 3, 'SchemaSource has 3 values');

# =============================================================================
# Test: SchemaInfo carrier + derived getters (4 tests)
# =============================================================================

var info = SchemaInfo(id: 'quest-overview', version: '1.0', path: '/x', source: SchemaSource.builtin);
verifyNotNull(info, 'SchemaInfo created');
verifyEquals(info.id, 'quest-overview', 'SchemaInfo id');
verifyEquals(info.fullId, 'quest-overview/1.0', 'SchemaInfo fullId getter');
verifyEquals(info.filenameId, 'quest-overview-1.0', 'SchemaInfo filenameId getter');

# =============================================================================
# Test: SpecSectionType.empty factory (4 tests)
# =============================================================================

var sst = SpecSectionType.empty('requirement');
verifyNotNull(sst, 'SpecSectionType.empty created');
verifyEquals(sst.type, 'requirement', 'SpecSectionType type');
verifyEquals(sst.isEmpty, true, 'SpecSectionType.empty isEmpty');
verifyEquals(sst.length, 0, 'SpecSectionType.empty length');

# =============================================================================
# Test: Schema definition value classes (connection-free const value objects)
# These describe a DocSpecs schema's section/form/subsection structure. They are
# plain const value objects with no IO and are safe to construct directly.
# =============================================================================

var patternCheck = PatternCheckDef(pattern: '^[a-z]+', errorMessage: 'must be lowercase');
verifyEquals(patternCheck.pattern, '^[a-z]+', 'PatternCheckDef pattern');
verifyEquals(patternCheck.errorMessage, 'must be lowercase', 'PatternCheckDef errorMessage');

var subConstraint = SubsectionConstraint(typeName: 'note', maxCount: 3);
verifyEquals(subConstraint.typeName, 'note', 'SubsectionConstraint typeName');
verifyEquals(subConstraint.maxCount, 3, 'SubsectionConstraint maxCount');

var sectionType = SectionTypeDef(name: 'requirement', prefix: 'REQ');
verifyEquals(sectionType.name, 'requirement', 'SectionTypeDef name');
verifyEquals(sectionType.prefix, 'REQ', 'SectionTypeDef prefix');

var forEachDef = ForEachDef(sectionType: 'item', key: 'id');
verifyEquals(forEachDef.sectionType, 'item', 'ForEachDef sectionType');
verifyEquals(forEachDef.key, 'id', 'ForEachDef key');

var sectionDef = SectionDef(sectionType: 'requirement', optional: true);
verifyEquals(sectionDef.sectionType, 'requirement', 'SectionDef sectionType');
verifyEquals(sectionDef.optional, true, 'SectionDef optional');

var subsectionDef = SubsectionDef(sectionType: 'detail', required: true);
verifyEquals(subsectionDef.sectionType, 'detail', 'SubsectionDef sectionType');
verifyEquals(subsectionDef.required, true, 'SubsectionDef required');

var docStruct = DocumentStructure(sections: {'requirement': sectionDef});
verifyEquals(docStruct.sections.length, 1, 'DocumentStructure sections');

var formField = FormFieldDef(fieldname: 'email', required: true);
verifyEquals(formField.fieldname, 'email', 'FormFieldDef fieldname');
verifyEquals(formField.required, true, 'FormFieldDef required');

var formType = FormTypeDef(name: 'login', fields: [formField]);
verifyEquals(formType.name, 'login', 'FormTypeDef name');
verifyEquals(formType.fields.length, 1, 'FormTypeDef fields');

# =============================================================================
# Test: DocSpecSchema assembled from the value classes + derived getters
# =============================================================================

var schema = DocSpecSchema(id: 'quest-overview', version: '1.0', sectionTypes: {'requirement': sectionType}, document: docStruct);
verifyEquals(schema.id, 'quest-overview', 'DocSpecSchema id');
verifyEquals(schema.version, '1.0', 'DocSpecSchema version');
verifyEquals(schema.fullId, 'quest-overview/1.0', 'DocSpecSchema fullId getter');
verifyEquals(schema.sectionTypes.length, 1, 'DocSpecSchema sectionTypes');

# =============================================================================
# Test: SpecSection / SpecDoc document model carriers
# =============================================================================

var specSection = SpecSection(index: 0, lineNumber: 1, rawHeadline: '# Req', name: 'Req', id: 'req', text: 'body', type: 'requirement');
verifyEquals(specSection.name, 'Req', 'SpecSection name');
verifyEquals(specSection.type, 'requirement', 'SpecSection type');

var specDoc = SpecDoc(index: 0, lineNumber: 1, rawHeadline: '# Doc', name: 'Doc', id: 'doc', text: 'body', filenameWithPath: 'a/b.md', loadTimestamp: '2026-01-01', filename: 'b.md', fullPath: '/ws/a/b.md', workspacePath: 'a/b.md', project: 'proj', projectPath: 'a', workspaceRoot: '/ws', projectRoot: '/ws/a', hierarchyDepth: 2, schemaId: 'quest-overview');
verifyEquals(specDoc.filename, 'b.md', 'SpecDoc filename');
verifyEquals(specDoc.schemaId, 'quest-overview', 'SpecDoc schemaId');

# =============================================================================
# Test: DocSpecsValidator / DocSpecsFactory wired over a schema (no IO)
# =============================================================================

var validator = DocSpecsValidator(schema: schema);
verifyNotNull(validator, 'DocSpecsValidator created');
verifyEquals(validator.schema.id, 'quest-overview', 'DocSpecsValidator holds its schema');

var factory = DocSpecsFactory(schema: schema);
verifyNotNull(factory, 'DocSpecsFactory created');
verifyEquals(factory.schema.id, 'quest-overview', 'DocSpecsFactory holds its schema');

# =============================================================================
# Test: Insert markers (parse + process are pure string transforms)
# =============================================================================

var marker = InsertMarker(variable: 'chat.lastReply', startLine: 1, endLine: 3, content: 'old');
verifyEquals(marker.variable, 'chat.lastReply', 'InsertMarker variable');
verifyEquals(marker.startLine, 1, 'InsertMarker startLine');
verifyEquals(marker.content, 'old', 'InsertMarker content');

var markerParser = InsertMarkerParser();
verifyEquals(markerParser.parse('plain text, no markers').length, 0, 'InsertMarkerParser finds no markers in plain text');

var markerProcessor = InsertMarkerProcessor();
verifyEquals(markerProcessor.process('plain text', {}), 'plain text', 'InsertMarkerProcessor leaves unmarked text unchanged');

# =============================================================================
# Test: SchemaFilenameParser static parse (pure filename parsing)
# =============================================================================

verifyNotNull(SchemaFilenameParser.parse('quest-overview-1.0.docspecs-schema.yaml'), 'SchemaFilenameParser parses a valid schema filename');
verifyEquals(SchemaFilenameParser.parse('not-a-schema.txt'), null, 'SchemaFilenameParser returns null for a non-schema filename');

# =============================================================================
# Test: SchemaExpander — pure [[...]] generator/placeholder expansion (5 tests)
# The expander walks a parsed schema map and rewrites [[selector;sep]] and
# [[key.field]] patterns from the non-reserved top-level keys. No IO.
# =============================================================================

var expPlaceholder = SchemaExpander({'meta': {'title': 'Hello'}});
verifyEquals(expPlaceholder.expand({'k': '[[meta.title]]'})['k'], 'Hello', 'SchemaExpander placeholder resolves a nested field');

var expGen = SchemaExpander({'items': ['a', 'b', 'c']});
verifyEquals(expGen.expand({'k': '[[items;-]]'})['k'], 'a-b-c', 'SchemaExpander generator joins a list with its separator');
verifyEquals(expGen.expand({'k': '[[items.length]]'})['k'], '3', 'SchemaExpander resolves .length');

var expUpper = SchemaExpander({'items': ['a', 'b']});
verifyEquals(expUpper.expand({'k': '[[items|uppercase;-]]'})['k'], 'A-B', 'SchemaExpander applies the uppercase transform');

var expEmpty = SchemaExpander({});
verifyEquals(expEmpty.expand({'k': '[[nope.x]]'})['k'], '[[nope.x]]', 'SchemaExpander leaves an unresolvable pattern literal');
verifyEquals(expEmpty.expand({'k': 'plain'})['k'], 'plain', 'SchemaExpander passes a pattern-free string through unchanged');

# =============================================================================
# Test: PromptExpander — pure ${...} placeholder expansion (6 tests)
# Rewrites ${id}/${text}/${type}/${index}/${lineNumber} etc. from the section
# and document. No IO. ($ is escaped as \$ so d4rt does not interpolate it.)
# =============================================================================

var peSection = SpecSection(index: 2, lineNumber: 7, rawHeadline: '# Req', name: 'Req', id: 'req', text: 'the body', type: 'requirement');
var peDoc = SpecDoc(index: 0, lineNumber: 1, rawHeadline: '# Doc', name: 'Doc', id: 'doc', text: 'body', filenameWithPath: 'a/b.md', loadTimestamp: '2026-01-01', filename: 'b.md', fullPath: '/ws/a/b.md', workspacePath: 'a/b.md', project: 'proj', projectPath: 'a', workspaceRoot: '/ws', projectRoot: '/ws/a', hierarchyDepth: 2, schemaId: 'quest-overview');
var promptExpander = PromptExpander();
verifyEquals(promptExpander.expand('\${id}', section: peSection, document: peDoc), 'req', 'PromptExpander resolves the id placeholder');
verifyEquals(promptExpander.expand('\${type}', section: peSection, document: peDoc), 'requirement', 'PromptExpander resolves the type placeholder');
verifyEquals(promptExpander.expand('\${text}', section: peSection, document: peDoc), 'the body', 'PromptExpander resolves the text placeholder');
verifyEquals(promptExpander.expand('\${index}=\${lineNumber}', section: peSection, document: peDoc), '2=7', 'PromptExpander resolves the index and lineNumber placeholders');
verifyEquals(promptExpander.expand('\${unknownKey}', section: peSection, document: peDoc), '\${unknownKey}', 'PromptExpander leaves an unknown placeholder literal');
verifyEquals(promptExpander.expand('no placeholders here', section: peSection, document: peDoc), 'no placeholders here', 'PromptExpander passes a placeholder-free prompt through');

# =============================================================================
# Test: SchemaResolver — constructor + pure static parsers/getter (6 tests)
# The resolve*/resolveByDocumentFilename* statics read schemas from disk and are
# integration-only; the constructor, schemaExtensions getter, extractDocumentType
# and isDocSpecDocument are pure and pinned here.
# =============================================================================

verifyNotNull(SchemaResolver(), 'SchemaResolver default constructor');
verifyEquals(SchemaResolver.schemaExtensions.length, 2, 'SchemaResolver.schemaExtensions lists both extensions');
verifyEquals(SchemaResolver.extractDocumentType('quest.overview.ds.md'), 'overview', 'SchemaResolver.extractDocumentType reads the <type> segment');
verifyEquals(SchemaResolver.extractDocumentType('plain.md'), null, 'SchemaResolver.extractDocumentType returns null for a non-ds.md name');
verifyEquals(SchemaResolver.isDocSpecDocument('quest.overview.ds.md'), true, 'SchemaResolver.isDocSpecDocument true for a ds.md name');
verifyEquals(SchemaResolver.isDocSpecDocument('plain.md'), false, 'SchemaResolver.isDocSpecDocument false for a plain name');

# =============================================================================
# Test: reachability of the AI-injection entry point
# AiValidator is pinned by reachability: it is an abstract LLM-injection
# interface with no invokable behaviour standalone. (DocSpecsSkeletonGenerator
# is driven live below over the RCK17 fixture schema — see RCJ8.)
# =============================================================================

verifyNotNull(AiValidator, 'AiValidator abstract interface exists');

# =============================================================================
# Test: IO/scan surfaces over a live self-contained fixture (RCK17)
# =============================================================================
#
# The d4rt binary runs with full IO access, so the IO/scan surfaces are driven
# against a temp directory tree built (and removed) inside this replay. Two
# schema-folder layouts are laid down so both resolution styles are exercised:
# a schema file DIRECTLY under `.tom/docspecs-schema/` (found by ID) and one in
# a `*.<type>/` subfolder (found by the `<title>.<type>.ds.md` convention).
#
# DECISION: the SYNC variants are covered. Their async twins (resolve,
# resolveByDocumentFilename, listSchemas(In), scanDocument(s), scanTree) await
# the exact same File operations; d4rt cannot top-level-`await` (interpreter
# state-machine bug), and the sync methods traverse identical IO code paths, so
# covering *Sync gives the same behavioural assurance without the await hazard.

# ---- fixture ----
var fxRoot = TomFs.tempDir(prefix: 'rck17_');
var fxSchemaDir = fxRoot + '/.tom/docspecs-schema';
TomFs.mkdir(fxSchemaDir);
var fxSchemaYaml = 'section-types:\n  overview:\n    prefix: overview\n    text-required: true\ndocument:\n  sections:\n    overview:\n      section-type: overview\n';
TomFs.write(fxSchemaDir + '/mini-1.0.docspecs-schema.yaml', fxSchemaYaml);
TomFs.mkdir(fxSchemaDir + '/quest.mini');
TomFs.write(fxSchemaDir + '/quest.mini/mini-1.0.docspecs-schema.yaml', fxSchemaYaml);
var fxDocsDir = fxRoot + '/docs';
TomFs.mkdir(fxDocsDir);
var fxDocPath = fxDocsDir + '/test.mini.ds.md';
TomFs.write(fxDocPath, '# <!-- schema=mini-1.0 --> Mini Test Document\n\n## <!--[overview] --> Overview\n\nThis is the overview body text.\n');

# ---- SchemaLoader.loadSync ----
var fxLoaded = SchemaLoader.loadSync(fxSchemaDir + '/mini-1.0.docspecs-schema.yaml');
verifyEquals(fxLoaded.id, 'mini', 'SchemaLoader.loadSync reads the schema id');
verifyEquals(fxLoaded.version, '1.0', 'SchemaLoader.loadSync reads the version');
verifyEquals(fxLoaded.fullId, 'mini/1.0', 'SchemaLoader.loadSync fullId');

# ---- SchemaResolver.resolveSync (by id, via schemaFolder) ----
var fxR1 = SchemaResolver.resolveSync(schemaId: 'mini-1.0', schemaFolder: fxSchemaDir);
verifyNotNull(fxR1, 'SchemaResolver.resolveSync resolves via schemaFolder');
verifyEquals(fxR1.id, 'mini', 'SchemaResolver.resolveSync resolved id');
verifyEquals(SchemaResolver.resolveSync(schemaId: 'nope-9.9', schemaFolder: fxSchemaDir), null, 'SchemaResolver.resolveSync returns null when unresolved');

# ---- SchemaResolver.resolveByDocumentFilenameSync (by <type>) ----
var fxR2 = SchemaResolver.resolveByDocumentFilenameSync(documentFilename: 'test.mini.ds.md', schemaFolder: fxSchemaDir);
verifyNotNull(fxR2, 'SchemaResolver.resolveByDocumentFilenameSync resolves the *.<type>/ folder');
verifyEquals(fxR2.id, 'mini', 'SchemaResolver.resolveByDocumentFilenameSync resolved id');
verifyEquals(SchemaResolver.resolveByDocumentFilenameSync(documentFilename: 'plain.md', schemaFolder: fxSchemaDir), null, 'SchemaResolver.resolveByDocumentFilenameSync null for a non-ds.md name');

# ---- SchemaDiscovery.listSchemas* ----
var fxInfos = SchemaDiscovery.listSchemasInSync(fxSchemaDir);
verify(fxInfos.length >= 1, 'SchemaDiscovery.listSchemasInSync discovers schema files');
verifyEquals(fxInfos[0].id, 'mini', 'SchemaDiscovery.listSchemasInSync SchemaInfo id');
verify(SchemaDiscovery.listSchemasSync(documentPath: fxDocPath, workspaceRoot: fxRoot).length >= 1, 'SchemaDiscovery.listSchemasSync walks up to the .tom folder');

# ---- DocSpecs facade (loadSchema / scan / validate / listSchemas) ----
var fxSchema = DocSpecs.loadSchemaSync(schemaId: 'mini-1.0', documentPath: fxDocPath, workspaceRoot: fxRoot);
verifyEquals(fxSchema.id, 'mini', 'DocSpecs.loadSchemaSync resolves through the document walk');
var fxScanned = DocSpecs.scanDocumentSync(filePath: fxDocPath, workspaceRoot: fxRoot);
verifyNotNull(fxScanned, 'DocSpecs.scanDocumentSync returns a SpecDoc');
verifyEquals(fxScanned.filename, 'test.mini.ds.md', 'DocSpecs.scanDocumentSync filename');
verifyNotNull(fxScanned.sections, 'DocSpecs.scanDocumentSync parsed the document sections');
verifyEquals(DocSpecs.scanDocumentsSync(filePaths: [fxDocPath], workspaceRoot: fxRoot).length, 1, 'DocSpecs.scanDocumentsSync count');
var fxFolder = DocSpecs.scanTreeSync(dirPath: fxDocsDir, workspaceRoot: fxRoot);
verifyNotNull(fxFolder, 'DocSpecs.scanTreeSync returns a DocumentFolder');
verify(fxFolder.allDocuments.length >= 1, 'DocSpecs.scanTreeSync discovered the fixture document');
verifyNotNull(DocSpecs.validate(fxScanned, schema: fxLoaded), 'DocSpecs.validate returns an error list');
verify(DocSpecs.listSchemasInSync(dirPath: fxSchemaDir).length >= 1, 'DocSpecs.listSchemasInSync facade');
verify(DocSpecs.listSchemasSync(documentPath: fxDocPath, workspaceRoot: fxRoot).length >= 1, 'DocSpecs.listSchemasSync facade');

# ---- DocSpecsSkeletonGenerator.generate (RCJ8) ----
# generate(schema) returns the skeleton markdown as a String (it does not write
# files itself — the caller persists it). Drive it over the loaded mini-1.0
# schema, assert the emitted structure, then persist it with TomFs and confirm
# the written file round-trips.
var fxSkeleton = DocSpecsSkeletonGenerator.generate(fxLoaded);
verify(fxSkeleton.contains('<!-- docspec: mini/1.0 -->'), 'DocSpecsSkeletonGenerator.generate emits the schema docspec comment');
verify(fxSkeleton.contains('# [overview-overview] Overview'), 'DocSpecsSkeletonGenerator.generate emits the Overview section headline');
verify(fxSkeleton.contains('TODO: Add content for this section.'), 'DocSpecsSkeletonGenerator.generate emits the text-required placeholder');
var fxSkeletonPath = fxDocsDir + '/skeleton.mini.ds.md';
TomFs.write(fxSkeletonPath, fxSkeleton);
verifyEquals(TomFs.exists(fxSkeletonPath), true, 'DocSpecsSkeletonGenerator skeleton written to disk');
verify(TomFs.read(fxSkeletonPath).contains('# [overview-overview] Overview'), 'written skeleton file contains the Overview section headline');

# ---- cleanup ----
TomFs.delete(fxRoot, recursive: true);

# =============================================================================
# Summary
# =============================================================================

testSummary();
