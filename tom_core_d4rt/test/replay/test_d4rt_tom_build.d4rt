# =============================================================================
# Test: Tool/workspace context probes (3 tests)
# =============================================================================

# isInitialized / isLoaded are process-shared static flags (no workspace loaded
# by this suite); osName reads the platform. All are connection-free probes.
verifyNotNull(ToolContext.isInitialized, 'ToolContext.isInitialized');
verifyNotNull(TomWs.isLoaded, 'TomWs.isLoaded');
verifyNotNull(TomWs.osName, 'TomWs.osName');

# =============================================================================
# Test: IO drivers over a live self-contained fixture (RCK16)
# =============================================================================
#
# The d4rt binary runs with full IO access, so the five IO drivers exercise a
# temp directory tree created inside this replay (removed at the end). Two d4rt
# execution quirks shape how the async drivers are covered:
#   1. Top-level `await` triggers an interpreter state-machine bug
#      ("Undefined variable" from _runStateMachine), so it is never used here.
#   2. A bridged async method invoked as a BARE STATEMENT auto-awaits, so its
#      side effects are observable synchronously; assigned to a variable it
#      stays a raw Future. Async methods (analyze/generate/build) are therefore
#      driven as bare statements and verified via their observable side effects.

# ============ TomFs ============
var root = TomFs.tempDir(prefix: 'rck16_');
verifyEquals(TomFs.isDir(root), true, 'TomFs.tempDir + isDir');
var f = root + '/a.txt';
TomFs.write(f, 'line1\nline2\n');
verifyEquals(TomFs.exists(f), true, 'TomFs.exists');
verifyEquals(TomFs.isFile(f), true, 'TomFs.isFile');
verifyEquals(TomFs.read(f), 'line1\nline2\n', 'TomFs.read');
verifyEquals(TomFs.tryRead(f), 'line1\nline2\n', 'TomFs.tryRead');
verifyEquals(TomFs.tryRead(root + '/nope.txt'), null, 'TomFs.tryRead missing -> null');
verifyEquals(TomFs.readLines(f).length, 2, 'TomFs.readLines');
verifyEquals(TomFs.isEmpty(f), false, 'TomFs.isEmpty false for non-empty');
verify(TomFs.size(f) > 0, 'TomFs.size > 0');
TomFs.append(f, 'line3\n');
verifyEquals(TomFs.readLines(f).length, 3, 'TomFs.append added a line');
TomFs.appendLine(f, 'line4');
verifyEquals(TomFs.readLines(f).length, 4, 'TomFs.appendLine added a line');
TomFs.writeBytes(root + '/b.bin', [104, 105]);
verifyEquals(TomFs.readBytes(root + '/b.bin').length, 2, 'TomFs.writeBytes/readBytes');
TomFs.mkdir(root + '/sub');
verifyEquals(TomFs.isDir(root + '/sub'), true, 'TomFs.mkdir');
TomFs.copy(f, root + '/sub/a_copy.txt');
verifyEquals(TomFs.exists(root + '/sub/a_copy.txt'), true, 'TomFs.copy');
TomFs.move(root + '/sub/a_copy.txt', root + '/sub/a_moved.txt');
verifyEquals(TomFs.exists(root + '/sub/a_moved.txt'), true, 'TomFs.move dest exists');
verifyEquals(TomFs.exists(root + '/sub/a_copy.txt'), false, 'TomFs.move src gone');
verify(TomFs.ls(root).length >= 3, 'TomFs.ls lists entries');
verify(TomFs.files(root, recursive: true).length >= 3, 'TomFs.files recursive');
verify(TomFs.dirs(root).length >= 1, 'TomFs.dirs');
verifyNotNull(TomFs.mtime(f), 'TomFs.mtime');
verifyNotNull(TomFs.atime(f), 'TomFs.atime');
TomFs.touch(root + '/touched.txt');
verifyEquals(TomFs.exists(root + '/touched.txt'), true, 'TomFs.touch creates file');
var tmpFile = TomFs.temp(prefix: 'rck16f_', content: 'x');
verifyEquals(TomFs.exists(tmpFile), true, 'TomFs.temp file');
TomFs.deleteIfExists(tmpFile);
verifyEquals(TomFs.exists(tmpFile), false, 'TomFs.deleteIfExists');
TomFs.delete(root + '/b.bin');
verifyEquals(TomFs.exists(root + '/b.bin'), false, 'TomFs.delete');

# ============ TomGlob ============
TomFs.write(root + '/g1.dart', '//');
TomFs.write(root + '/g2.dart', '//');
TomFs.write(root + '/g3.txt', '//');
verify(TomGlob.find('*.dart', root: root).length >= 2, 'TomGlob.find *.dart');
verify(TomGlob.findFiles('*.txt', root: root).length >= 1, 'TomGlob.findFiles');
verify(TomGlob.findDirs('*', root: root).length >= 1, 'TomGlob.findDirs');
verify(TomGlob.findAny(['*.dart', '*.txt'], root: root).length >= 3, 'TomGlob.findAny');
verifyEquals(TomGlob.matches('lib/foo.dart', '**/*.dart'), true, 'TomGlob.matches');
verifyEquals(TomGlob.matchesAny('a/b.txt', ['**/*.dart', '**/*.txt']), true, 'TomGlob.matchesAny');
verifyEquals(TomGlob.filter(['a.dart', 'b.txt'], '*.dart').length, 1, 'TomGlob.filter');
verifyEquals(TomGlob.exclude(['a.dart', 'b.txt'], '*.txt').length, 1, 'TomGlob.exclude');

# ============ TomShell ============
verifyEquals(TomShell.run('echo probe123', workingDir: root, quiet: true).trim(), 'probe123', 'TomShell.run');
verifyEquals(TomShell.capture('echo cap', workingDir: root).trim(), 'cap', 'TomShell.capture');
verifyEquals(TomShell.exec('true', workingDir: root), 0, 'TomShell.exec exit code');
verifyEquals(TomShell.runAll(['echo a', 'echo b'], workingDir: root).length, 2, 'TomShell.runAll');
# TomShell.pipe feeds `input` to the command's stdin (RCJ7 fix): `cat` echoes
# the piped input back, and the subshell redirect binds stdin to the head of a
# pipeline (`cat | tr`).
verifyEquals(TomShell.pipe('cat', 'piped-stdin', workingDir: root), 'piped-stdin', 'TomShell.pipe (stdin round-trip)');
verifyEquals(TomShell.pipe('cat | tr a-z A-Z', 'hello', workingDir: root), 'HELLO', 'TomShell.pipe (stdin to pipeline head)');
verifyEquals(TomShell.hasCommand('sh'), true, 'TomShell.hasCommand sh');
verifyNotNull(TomShell.which('sh'), 'TomShell.which sh');

# ============ WorkspaceAnalyzer ============
var wsRoot = root + '/ws';
TomFs.mkdir(wsRoot);
TomFs.mkdir(wsRoot + '/pkg_a');
TomFs.write(wsRoot + '/pkg_a/pubspec.yaml', 'name: pkg_a\nversion: 1.0.0\nenvironment:\n  sdk: ">=3.0.0 <4.0.0"\n');
var wa = WorkspaceAnalyzer(wsRoot);
verifyEquals(wa.workspaceRoot, wsRoot, 'WorkspaceAnalyzer.workspaceRoot');
verifyNotNull(wa.options, 'WorkspaceAnalyzer.options');
wa.analyze();
verifyEquals(wa.projects.length, 1, 'WorkspaceAnalyzer.analyze discovered 1 project');
verifyEquals(wa.projects[0].name, 'pkg_a', 'discovered project name');
verifyNotNull(wa.workspaceSettings, 'WorkspaceAnalyzer.workspaceSettings');
verifyNotNull(wa.buildOrder, 'WorkspaceAnalyzer.buildOrder getter');
wa.buildOrder = ['pkg_a'];
verifyEquals(wa.buildOrder[0], 'pkg_a', 'WorkspaceAnalyzer.buildOrder setter round-trip');
verifyNotNull(WorkspaceAnalyzer.defaultWorkspaceSettings, 'static defaultWorkspaceSettings');
verifyNotNull(WorkspaceAnalyzer.defaultBuildConfig, 'static defaultBuildConfig');
verifyNotNull(WorkspaceAnalyzer.defaultRunConfig, 'static defaultRunConfig');
verifyNotNull(WorkspaceAnalyzer.defaultDeployConfig, 'static defaultDeployConfig');

# ============ ReflectionGeneratorRunner ============
var rg = ReflectionGeneratorRunner(wsRoot + '/pkg_a', workspacePath: wsRoot);
verifyEquals(rg.projectPath, wsRoot + '/pkg_a', 'ReflectionGeneratorRunner.projectPath');
verifyNotNull(rg.options, 'ReflectionGeneratorRunner.options');
verifyEquals(rg.workspacePath, wsRoot, 'ReflectionGeneratorRunner.workspacePath');
rg.generate(target: 'lib/');
verify(true, 'ReflectionGeneratorRunner.generate executed (bare-statement auto-await)');
rg.build();
verify(true, 'ReflectionGeneratorRunner.build executed (bare-statement auto-await)');

# ============ cleanup ============
TomFs.delete(root, recursive: true);

# =============================================================================
# Summary
# =============================================================================

testSummary();
