# =============================================================================
# Test: TomEnv static resolution + probes (3 tests)
# =============================================================================

# resolveWith passes plain text through unchanged; has() reports absent keys as
# false; isMacOS is a platform bool (present regardless of host).
verifyEquals(TomEnv.resolveWith('plain', {}), 'plain', 'TomEnv.resolveWith passthrough');
verifyEquals(TomEnv.has('__TOM_NOPE__'), false, 'TomEnv.has absent key');
verifyNotNull(TomEnv.isMacOS, 'TomEnv.isMacOS');

# =============================================================================
# Test: TomMaps static deep-map ops (4 tests)
# =============================================================================

var merged = TomMaps.merge({'a': 1}, {'b': 2});
verifyEquals(merged['a'], 1, 'TomMaps.merge keeps base');
verifyEquals(merged['b'], 2, 'TomMaps.merge adds override');
var flattened = TomMaps.flatten({'a': {'b': 1}});
verifyEquals(flattened['a.b'], 1, 'TomMaps.flatten dotted key');
verifyEquals(TomMaps.get({'a': 1}, 'a'), 1, 'TomMaps.get present key');
verifyEquals(TomMaps.has({'a': 1}, 'a'), true, 'TomMaps.has present path');

