# D4rt Test Suite - Tom Reflection Classes
# Run with: d4rt -run-replay test_d4rt_tom_reflection.d4rt -test
# Tests tom_reflection bridged classes: capability markers + singletons,
# the StringInvocationKind enum, the mirror interfaces, and the error types.


# =============================================================================
# Test: Reflection / core classes exist (abstract - existence only)
# =============================================================================

verifyNotNull(Reflection, 'Reflection class exists');
verifyNotNull(ReflectionInterface, 'ReflectionInterface class exists');
verifyNotNull(StringInvocation, 'StringInvocation class exists');
verifyNotNull(TypeValue, 'TypeValue class exists');

# =============================================================================
# Test: Capability classes exist
# =============================================================================

verifyNotNull(ReflectCapability, 'ReflectCapability class exists');
verifyNotNull(ApiReflectCapability, 'ApiReflectCapability class exists');
verifyNotNull(NamePatternCapability, 'NamePatternCapability class exists');
verifyNotNull(MetadataQuantifiedCapability, 'MetadataQuantifiedCapability class exists');
verifyNotNull(InstanceInvokeCapability, 'InstanceInvokeCapability class exists');
verifyNotNull(StaticInvokeCapability, 'StaticInvokeCapability class exists');
verifyNotNull(TopLevelInvokeCapability, 'TopLevelInvokeCapability class exists');
verifyNotNull(NewInstanceCapability, 'NewInstanceCapability class exists');
verifyNotNull(TypeCapability, 'TypeCapability class exists');
verifyNotNull(LibraryCapability, 'LibraryCapability class exists');
verifyNotNull(DeclarationsCapability, 'DeclarationsCapability class exists');
verifyNotNull(InvokingCapability, 'InvokingCapability class exists');
verifyNotNull(TypingCapability, 'TypingCapability class exists');
verifyNotNull(SuperclassQuantifyCapability, 'SuperclassQuantifyCapability class exists');

# =============================================================================
# Test: NamePatternCapability constructors preserve namePattern
# =============================================================================

var iCap = InstanceInvokeCapability('greet');
verifyEquals(iCap.namePattern, 'greet', 'InstanceInvokeCapability namePattern preserved');

var sCap = StaticInvokeCapability('build.*');
verifyEquals(sCap.namePattern, 'build.*', 'StaticInvokeCapability namePattern preserved');

var tCap = TopLevelInvokeCapability('main');
verifyEquals(tCap.namePattern, 'main', 'TopLevelInvokeCapability namePattern preserved');

var nCap = NewInstanceCapability('from.*');
verifyEquals(nCap.namePattern, 'from.*', 'NewInstanceCapability namePattern preserved');

# =============================================================================
# Test: Ready-made capability singletons
# =============================================================================

verifyNotNull(instanceInvokeCapability, 'instanceInvokeCapability singleton exists');
verifyEquals(instanceInvokeCapability.namePattern, '', 'instanceInvokeCapability matches all (empty pattern)');
verifyEquals(staticInvokeCapability.namePattern, '', 'staticInvokeCapability matches all (empty pattern)');
verifyEquals(topLevelInvokeCapability.namePattern, '', 'topLevelInvokeCapability matches all (empty pattern)');
verifyEquals(newInstanceCapability.namePattern, '', 'newInstanceCapability matches all (empty pattern)');
verifyEquals(invokingCapability.namePattern, '', 'invokingCapability matches all (empty pattern)');
verifyNotNull(typeCapability, 'typeCapability singleton exists');
verifyNotNull(metadataCapability, 'metadataCapability singleton exists');
verifyNotNull(libraryCapability, 'libraryCapability singleton exists');
verifyNotNull(declarationsCapability, 'declarationsCapability singleton exists');
verifyNotNull(typingCapability, 'typingCapability singleton exists');
verifyNotNull(uriCapability, 'uriCapability singleton exists');

# =============================================================================
# Test: StringInvocationKind enum
# =============================================================================

verifyEquals(StringInvocationKind.method.name, 'method', 'StringInvocationKind.method name');
verifyEquals(StringInvocationKind.getter.name, 'getter', 'StringInvocationKind.getter name');
verifyEquals(StringInvocationKind.setter.name, 'setter', 'StringInvocationKind.setter name');
verifyEquals(StringInvocationKind.constructor.name, 'constructor', 'StringInvocationKind.constructor name');
verifyLength(StringInvocationKind.values, 4, 'StringInvocationKind has 4 values');

# =============================================================================
# Test: *MetaCapability constructors (take a Type metadataType)
# These const value markers carry a metadata Type; construct each + assert the
# metadataType getter is reachable (the Type round-trips through the bridge).
# =============================================================================

var iMeta = InstanceInvokeMetaCapability(String);
verifyNotNull(iMeta, 'InstanceInvokeMetaCapability created');
verifyNotNull(iMeta.metadataType, 'InstanceInvokeMetaCapability metadataType getter');

var sMeta = StaticInvokeMetaCapability(int);
verifyNotNull(sMeta, 'StaticInvokeMetaCapability created');
verifyNotNull(sMeta.metadataType, 'StaticInvokeMetaCapability metadataType getter');

var tMeta = TopLevelInvokeMetaCapability(bool);
verifyNotNull(tMeta, 'TopLevelInvokeMetaCapability created');
verifyNotNull(tMeta.metadataType, 'TopLevelInvokeMetaCapability metadataType getter');

var nMeta = NewInstanceMetaCapability(double);
verifyNotNull(nMeta, 'NewInstanceMetaCapability created');
verifyNotNull(nMeta.metadataType, 'NewInstanceMetaCapability metadataType getter');

# =============================================================================
# Test: the 10 previously-unreferenced capability singletons
# Const markers registered as global variables; pin each for existence so a
# generator regression dropping any of them fails the replay.
# =============================================================================

verifyNotNull(typeRelationsCapability, 'typeRelationsCapability singleton exists');
verifyNotNull(reflectedTypeCapability, 'reflectedTypeCapability singleton exists');
verifyNotNull(libraryDependenciesCapability, 'libraryDependenciesCapability singleton exists');
verifyNotNull(delegateCapability, 'delegateCapability singleton exists');
verifyNotNull(subtypeQuantifyCapability, 'subtypeQuantifyCapability singleton exists');
verifyNotNull(superclassQuantifyCapability, 'superclassQuantifyCapability singleton exists');
verifyNotNull(typeAnnotationQuantifyCapability, 'typeAnnotationQuantifyCapability singleton exists');
verifyNotNull(typeAnnotationDeepQuantifyCapability, 'typeAnnotationDeepQuantifyCapability singleton exists');
verifyNotNull(correspondingSetterQuantifyCapability, 'correspondingSetterQuantifyCapability singleton exists');
verifyNotNull(admitSubtypeCapability, 'admitSubtypeCapability singleton exists');

# =============================================================================
# Test: the 5 global error-constructor functions
# These functions THROW their reflection error (they do not return it), so drive
# each through verifyThrows. Named arguments passed as null (d4rt has no Symbol
# literal), positional arguments as an empty list.
# =============================================================================

verifyThrows(() => reflectionNoSuchInvokableError('recv', 'doThing', [], null, StringInvocationKind.method), 'reflectionNoSuchInvokableError throws');
verifyThrows(() => reflectionNoSuchMethodError('recv', 'doThing', [], null), 'reflectionNoSuchMethodError throws');
verifyThrows(() => reflectionNoSuchGetterError('recv', 'value', [], null), 'reflectionNoSuchGetterError throws');
verifyThrows(() => reflectionNoSuchSetterError('recv', 'value', [], null), 'reflectionNoSuchSetterError throws');
verifyThrows(() => reflectionNoSuchConstructorError('recv', 'Widget', [], null), 'reflectionNoSuchConstructorError throws');

# =============================================================================
# Test: Error types
# =============================================================================

var noCapErr = NoSuchCapabilityError('No such capability');
verifyNotNull(noCapErr, 'NoSuchCapabilityError created');
verifyNotNull(ReflectionNoSuchMethodError, 'ReflectionNoSuchMethodError class exists');

# =============================================================================
# Test: Mirror interfaces exist (abstract - existence only)
# =============================================================================

verifyNotNull(Mirror, 'Mirror class exists');
verifyNotNull(DeclarationMirror, 'DeclarationMirror class exists');
verifyNotNull(ObjectMirror, 'ObjectMirror class exists');
verifyNotNull(InstanceMirror, 'InstanceMirror class exists');
verifyNotNull(LibraryMirror, 'LibraryMirror class exists');
verifyNotNull(TypeMirror, 'TypeMirror class exists');
verifyNotNull(ClassMirror, 'ClassMirror class exists');
verifyNotNull(MethodMirror, 'MethodMirror class exists');
verifyNotNull(VariableMirror, 'VariableMirror class exists');
verifyNotNull(ParameterMirror, 'ParameterMirror class exists');

# =============================================================================
# Test: remaining constructable capability + value classes (RCF5)
# InvokingMetaCapability(Type) carries a metadata Type like the other
# *MetaCapability markers; Comment(text, trimmedText, isDocComment) is a value
# object whose three getters must round-trip through the bridge.
# =============================================================================

var invMeta = InvokingMetaCapability(String);
verifyNotNull(invMeta, 'InvokingMetaCapability created');
verifyNotNull(invMeta.metadataType, 'InvokingMetaCapability metadataType getter');

var comment = Comment('/// docs', 'docs', true);
verifyEquals(comment.text, '/// docs', 'Comment text preserved');
verifyEquals(comment.trimmedText, 'docs', 'Comment trimmedText preserved');
verifyEquals(comment.isDocComment, true, 'Comment isDocComment preserved');

# =============================================================================
# Test: remaining capability CLASS tokens (RCF5)
# These are the class tokens for capabilities previously reached only through
# their const singleton (metadataCapability, uriCapability, …) or that require a
# Reflection instance to construct (Global*/ImportAttached — existence only).
# Pinning the class token fails the replay if a generator regression drops the
# bridge registration.
# =============================================================================

verifyNotNull(MetadataCapability, 'MetadataCapability class exists');
verifyNotNull(TypeRelationsCapability, 'TypeRelationsCapability class exists');
verifyNotNull(LibraryDependenciesCapability, 'LibraryDependenciesCapability class exists');
verifyNotNull(UriCapability, 'UriCapability class exists');
verifyNotNull(TypeAnnotationQuantifyCapability, 'TypeAnnotationQuantifyCapability class exists');
verifyNotNull(ReflecteeQuantifyCapability, 'ReflecteeQuantifyCapability class exists');
verifyNotNull(GlobalQuantifyCapability, 'GlobalQuantifyCapability class exists');
verifyNotNull(GlobalQuantifyMetaCapability, 'GlobalQuantifyMetaCapability class exists');
verifyNotNull(ImportAttachedCapability, 'ImportAttachedCapability class exists');

# =============================================================================
# Test: remaining mirror interfaces + SourceLocation (RCF5)
# Abstract types — existence only, matching the mirror-interface block above.
# Together with that block these pin every bridged mirror type.
# =============================================================================

verifyNotNull(ClosureMirror, 'ClosureMirror class exists');
verifyNotNull(FunctionTypeMirror, 'FunctionTypeMirror class exists');
verifyNotNull(TypeVariableMirror, 'TypeVariableMirror class exists');
verifyNotNull(TypedefMirror, 'TypedefMirror class exists');
verifyNotNull(LibraryDependencyMirror, 'LibraryDependencyMirror class exists');
verifyNotNull(CombinatorMirror, 'CombinatorMirror class exists');
verifyNotNull(SourceLocation, 'SourceLocation class exists');

# =============================================================================
# Summary
# =============================================================================

testSummary();
