# D4rt Test Suite - Tom Md2Latex Classes
# Run with: d4rt test_d4rt_tom_md2latex.d4rt -test
# Tests tom_md2latex bridged classes (markdown element model, parser, converter API).
# NOTE: Uses single-line syntax for D4rt parser compatibility.
#
# Coverage contract: every registered bridge NAME (23 classes) is referenced as a
# non-comment identifier below, and each class's connection-free surface is
# exercised. The following members are intentionally NOT exercised because they
# require filesystem/IO or async reachability, not because of a coverage gap:
#   - MdLatexConverter.findMarkdownFiles / convertAll / convertFile  (Future + dart:io)
#   - Md2Latex.convertFile / convertFileToString / convertFileToStringSync /
#     convertDirectory                                               (Future/IO)
# The pure, connection-free members of those same classes ARE exercised
# (MdLatexConverter.convert, Md2Latex.convertString / parse), so each such class
# is covered by real behaviour rather than a bare existence pin.
# GOTCHA: any ${...} placeholder in a .d4rt string must be escaped as \${...}.


# =============================================================================
# Test: MarkdownElement sealed base (subtype + reachability)
# MarkdownElement is `sealed class MarkdownElement {}` with no own members; its
# only observable contract is that every concrete element is-a MarkdownElement.
# =============================================================================

verifyNotNull(MarkdownElement, 'MarkdownElement sealed base exists');

var h = HeadingElement('Title', 2);
verify(h is MarkdownElement, 'HeadingElement is a MarkdownElement');
verifyEquals(h.text, 'Title', 'HeadingElement text');
verifyEquals(h.level, 2, 'HeadingElement level');

# =============================================================================
# Test: Markdown element value carriers (construct + getters)
# =============================================================================

var para = ParagraphElement(text: 'a paragraph');
verify(para is MarkdownElement, 'ParagraphElement is a MarkdownElement');
verifyEquals(para.text, 'a paragraph', 'ParagraphElement text');

var code = CodeBlockElement(code: 'print(1)', language: 'dart');
verifyEquals(code.code, 'print(1)', 'CodeBlockElement code');
verifyEquals(code.language, 'dart', 'CodeBlockElement language');
verifyEquals(code.isAsciiDiagram, false, 'CodeBlockElement isAsciiDiagram default');

var img = ImageElement(altText: 'alt', url: 'u.png');
verifyEquals(img.altText, 'alt', 'ImageElement altText');
verifyEquals(img.url, 'u.png', 'ImageElement url');

var link = LinkElement(text: 'site', url: 'https://x');
verifyEquals(link.text, 'site', 'LinkElement text');
verifyEquals(link.url, 'https://x', 'LinkElement url');

var inlineCode = InlineCodeElement(code: 'x = 1');
verifyEquals(inlineCode.code, 'x = 1', 'InlineCodeElement code');

var quote = BlockQuoteElement(text: 'a quote');
verifyEquals(quote.text, 'a quote', 'BlockQuoteElement text');

var rule = HorizontalRuleElement();
verify(rule is MarkdownElement, 'HorizontalRuleElement is a MarkdownElement');

var raw = RawTextElement(text: 'rawtext');
verifyEquals(raw.text, 'rawtext', 'RawTextElement text');

# =============================================================================
# Test: List + table carriers (construct + getters)
# =============================================================================

var ul = UnorderedListElement(items: ['one', 'two']);
verifyEquals(ul.items.length, 2, 'UnorderedListElement items');

var ol = OrderedListElement(items: ['first']);
verifyEquals(ol.items.length, 1, 'OrderedListElement items');

var table = TableElement(headers: ['A', 'B'], rows: [['1', '2']], alignments: ['left', 'right']);
verifyEquals(table.headers.length, 2, 'TableElement headers');
verifyEquals(table.rows.length, 1, 'TableElement rows');
verifyEquals(table.alignments.length, 2, 'TableElement alignments');

# =============================================================================
# Test: ParsedMarkdown document model (construct + all 6 getters + defaults)
# ParsedMarkdown is the parser's output aggregate; built directly here to prove
# every getter, including the frontmatter fields (author/date/generateToc/
# tocDepth) that the '# Hello' parse below does not populate.
# =============================================================================

var pm = ParsedMarkdown(title: 'T', author: 'A', date: '2026-01-01', generateToc: true, tocDepth: 4, elements: [h, para]);
verifyEquals(pm.title, 'T', 'ParsedMarkdown title');
verifyEquals(pm.author, 'A', 'ParsedMarkdown author');
verifyEquals(pm.date, '2026-01-01', 'ParsedMarkdown date');
verifyEquals(pm.generateToc, true, 'ParsedMarkdown generateToc');
verifyEquals(pm.tocDepth, 4, 'ParsedMarkdown tocDepth');
verifyEquals(pm.elements.length, 2, 'ParsedMarkdown elements');
verify(pm.elements[0] is MarkdownElement, 'ParsedMarkdown elements are MarkdownElement');

var pmDefaults = ParsedMarkdown(elements: []);
verifyEquals(pmDefaults.title, null, 'ParsedMarkdown title null by default');
verifyEquals(pmDefaults.generateToc, false, 'ParsedMarkdown generateToc false by default');

# =============================================================================
# Test: MarkdownParserOptions defaults + getters
# =============================================================================

var opts = MarkdownParserOptions();
verifyEquals(opts.detectAsciiDiagrams, true, 'MarkdownParserOptions detectAsciiDiagrams default');
verifyNotNull(opts.asciiDiagramPatterns, 'MarkdownParserOptions asciiDiagramPatterns present');

# =============================================================================
# Test: MarkdownParser construct + getters + end-to-end parse
#
# The name must be qualified: tom_doc_scanner declares a MarkdownParser too, and
# this binary registers both barrels, so the bare name is ambiguous. The package
# qualifier needs no import directive — see
# tom_d4rt_generator/_copilot_guidelines/same_name_class_resolution.md.
# =============================================================================

var mp = tom_md2latex.MarkdownParser('# Hi\n\nbody');
verifyEquals(mp.content, '# Hi\n\nbody', 'MarkdownParser content getter');
verifyNotNull(mp.options, 'MarkdownParser options getter');

var parsed = tom_md2latex.MarkdownParser('# Hello\n\nbody text').parse();
verifyEquals(parsed.title, 'Hello', 'MarkdownParser parse title from h1');
verifyEquals(parsed.elements.length, 2, 'MarkdownParser parse element count');
verify(parsed.elements[0] is HeadingElement, 'MarkdownParser first element is HeadingElement');

# =============================================================================
# Test: Md2Latex static convenience API (pure)
# =============================================================================

var latex = Md2Latex.convertString(markdown: '# Hello\n\nWorld', generatePreamble: false);
verifyContains(latex, 'section', 'Md2Latex.convertString emits a section');

var parsed2 = Md2Latex.parse('# Hi');
verifyEquals(parsed2.title, 'Hi', 'Md2Latex.parse title');

# =============================================================================
# Test: LatexMacros pure static string transforms
# All LatexMacros methods are pure (no IO); a representative connection-free set
# is exercised via substring assertions on the emitted LaTeX.
# =============================================================================

verifyContains(LatexMacros.bold('BB'), 'textbf', 'LatexMacros.bold wraps in textbf');
verifyContains(LatexMacros.italic('II'), 'textit', 'LatexMacros.italic wraps in textit');
verifyContains(LatexMacros.heading('Head', 1), 'section', 'LatexMacros.heading level 1 is a section');
verifyContains(LatexMacros.paragraph('PP'), 'PP', 'LatexMacros.paragraph preserves text');
verifyContains(LatexMacros.inlineCode('CC'), 'CC', 'LatexMacros.inlineCode preserves code');
verifyContains(LatexMacros.horizontalRule(), 'mdhorizontalrule', 'LatexMacros.horizontalRule');
verifyContains(LatexMacros.beginDocument(), 'document', 'LatexMacros.beginDocument');
verifyContains(LatexMacros.endDocument(), 'document', 'LatexMacros.endDocument');
verifyContains(LatexMacros.makeTitle(), 'maketitle', 'LatexMacros.makeTitle');
verifyContains(LatexMacros.unorderedList(['a']), 'itemize', 'LatexMacros.unorderedList');
verifyContains(LatexMacros.orderedList(['a']), 'enumerate', 'LatexMacros.orderedList');
verifyContains(LatexMacros.blockQuote('q'), 'quote', 'LatexMacros.blockQuote');
verifyContains(LatexMacros.link('t', 'https://x'), 'href', 'LatexMacros.link external uses href');
verifyEquals(LatexMacros.textToSlug('My Title'), 'my-title', 'LatexMacros.textToSlug');
verifyNotNull(LatexMacros.escapeText('a & b'), 'LatexMacros.escapeText returns a string');
verifyNotNull(LatexMacros.image('alt', 'i.png'), 'LatexMacros.image returns a string');
verifyNotNull(LatexMacros.codeBlock('c', language: 'dart'), 'LatexMacros.codeBlock returns a string');

# =============================================================================
# Test: MdLatexConverter pure conversion + getters
# convert(markdownContent) is the pure, filesystem-free entry point; the
# constructor's sourcePath is not touched by it. IO methods (convertAll etc.)
# are integration-only and documented in the header.
# =============================================================================

var mc = MdLatexConverter('/nonexistent');
verifyEquals(mc.sourcePath, '/nonexistent', 'MdLatexConverter sourcePath getter');
verifyNotNull(mc.options, 'MdLatexConverter options getter');
verifyContains(mc.convert('# Title\n\nbody'), 'section', 'MdLatexConverter.convert emits a section');

# =============================================================================
# Test: MdLatexConverterOptions defaults + getters
# =============================================================================

var mo = MdLatexConverterOptions();
verifyEquals(mo.generatePreamble, true, 'MdLatexConverterOptions generatePreamble default');
verifyEquals(mo.documentClass, 'article', 'MdLatexConverterOptions documentClass default');
verifyEquals(mo.generateToc, true, 'MdLatexConverterOptions generateToc default');
verifyEquals(mo.tocDepth, 3, 'MdLatexConverterOptions tocDepth default');
verifyNotNull(mo.excludePatterns, 'MdLatexConverterOptions excludePatterns present');
verifyNotNull(mo.parserOptions, 'MdLatexConverterOptions parserOptions present');

# =============================================================================
# Test: Converter result + converted-file + error carriers
# A fresh MdLatexConverterResult has no converted files and no errors, so it is
# successful. ConvertedFile wraps a parsed document plus its source/output paths.
# ConversionError is a pure value carrier for a failed conversion.
# =============================================================================

var conv = MdLatexConverterResult();
verifyEquals(conv.isSuccess, true, 'MdLatexConverterResult empty result is success');
verifyEquals(conv.converted.length, 0, 'MdLatexConverterResult no converted files by default');
verifyEquals(conv.errors.length, 0, 'MdLatexConverterResult no errors by default');
verifyEquals(conv.totalProcessed, 0, 'MdLatexConverterResult totalProcessed default');

var cfile = ConvertedFile(sourcePath: 's.md', outputPath: 'o.tex', parsed: parsed);
verifyEquals(cfile.sourcePath, 's.md', 'ConvertedFile sourcePath');
verifyEquals(cfile.outputPath, 'o.tex', 'ConvertedFile outputPath');
verifyNotNull(cfile.parsed, 'ConvertedFile parsed present');

var err = ConversionError(sourcePath: 'f.md', message: 'boom');
verifyEquals(err.sourcePath, 'f.md', 'ConversionError sourcePath');
verifyEquals(err.message, 'boom', 'ConversionError message');
verifyContains(err.toString(), 'ConversionError', 'ConversionError toString');

# =============================================================================
# Summary
# =============================================================================

testSummary();
