# D4rt Test Suite - Tom Doc Scanner Classes
# Run with: d4rt test_d4rt_tom_doc_scanner.d4rt -test
# Tests tom_doc_scanner bridged classes (markdown parser, section/document model).
# NOTE: Uses single-line syntax for D4rt parser compatibility.


# =============================================================================
# Test: ParsedHeadline value carrier (5 tests)
# =============================================================================

var ph = ParsedHeadline(level: 2, lineNumber: 3, rawHeadline: '## Title', text: 'Title', fields: {'type': 'api'});
verifyNotNull(ph, 'ParsedHeadline created');
verifyEquals(ph.level, 2, 'ParsedHeadline level');
verifyEquals(ph.lineNumber, 3, 'ParsedHeadline lineNumber');
verifyEquals(ph.text, 'Title', 'ParsedHeadline text');
verifyEquals(ph.fields['type'], 'api', 'ParsedHeadline fields');

# =============================================================================
# Test: Section value carrier (5 tests)
# =============================================================================

var sec = Section(index: 0, lineNumber: 1, rawHeadline: 'Main', name: 'Main', id: 'main', text: 'body');
verifyNotNull(sec, 'Section created');
verifyEquals(sec.index, 0, 'Section index');
verifyEquals(sec.name, 'Main', 'Section name');
verifyEquals(sec.id, 'main', 'Section id');
verifyEquals(sec.fields.length, 0, 'Section fields default empty');

# =============================================================================
# Test: MarkdownParser.generateId static helper (3 tests)
# =============================================================================

verifyEquals(MarkdownParser.generateId('Title', null, 0), 'title', 'generateId single word lowercased');
verifyEquals(MarkdownParser.generateId('My Section', 'parent', 2), 'parent.2', 'generateId multi-word uses parent.index');
verifyEquals(MarkdownParser.generateId('Hello World', null, 0), 'hello_world', 'generateId fallback snake_case');

# =============================================================================
# Test: MarkdownParser.extractText static helper (1 test)
# =============================================================================

verifyEquals(MarkdownParser.extractText('# Title\nbody line\n## Sub', 0, 1), 'body line', 'extractText between headlines');

# =============================================================================
# Test: Document value carrier (construct + getters)
# A Document is a plain value object describing one scanned markdown file; it
# carries no scanner/IO state and is safe to construct directly (sections omitted).
# =============================================================================

var doc = Document(index: 0, lineNumber: 1, name: 'Doc', id: 'doc', rawHeadline: '# Doc', fields: {'type': 'guide'}, text: 'body', filenameWithPath: 'a/b.md', loadTimestamp: '2026-01-01', filename: 'b.md', fullPath: '/ws/a/b.md', workspacePath: 'a/b.md', project: 'proj', projectPath: 'a', workspaceRoot: '/ws', projectRoot: '/ws/a', hierarchyDepth: 2);
verifyNotNull(doc, 'Document created');
verifyEquals(doc.filename, 'b.md', 'Document filename');
verifyEquals(doc.project, 'proj', 'Document project');
verifyEquals(doc.hierarchyDepth, 2, 'Document hierarchyDepth');
verifyEquals(doc.fields['type'], 'guide', 'Document fields');

# =============================================================================
# Test: DocumentFolder value carrier (construct + derived getter)
# Holds the documents/subfolders found in one folder; allDocuments aggregates the
# tree. No filesystem access is required to build or inspect one.
# =============================================================================

var folder = DocumentFolder(foldername: 'docs', workspaceFolderPath: 'docs', absoluteFolderPath: '/ws/docs', documents: [doc], folders: []);
verifyNotNull(folder, 'DocumentFolder created');
verifyEquals(folder.foldername, 'docs', 'DocumentFolder foldername');
verifyEquals(folder.documents.length, 1, 'DocumentFolder documents');
verifyEquals(folder.folders.length, 0, 'DocumentFolder folders');
verifyEquals(folder.allDocuments.length, 1, 'DocumentFolder allDocuments aggregates the tree');

# =============================================================================
# Test: Classes exist (2 tests)
# DocScanner/DocScannerFactory walk the filesystem; they stay integration-only.
# =============================================================================

verifyNotNull(DocScanner, 'DocScanner class exists');
verifyNotNull(DocScannerFactory, 'DocScannerFactory class exists');

# =============================================================================
# Summary
# =============================================================================

testSummary();
