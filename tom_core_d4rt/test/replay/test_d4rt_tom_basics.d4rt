# D4rt Test Suite - Part 1: TomBasics Classes
# Run with: d4rt -run-replay test_d4rt_tom_basics.d4rt -test
# Tests TomBasics bridged classes: tomLog, TomLogLevel, TomPlatform constants


# =============================================================================
# Test: tomLog Global Variable (5 tests)
# =============================================================================

verifyNotNull(tomLog, 'tomLog global exists');

tomLog.info('Test info message from D4rt test');
verify(true, 'tomLog.info executed');

tomLog.debug('Debug message');
verify(true, 'tomLog.debug executed');

tomLog.warn('Warning message');
verify(true, 'tomLog.warn executed');

# Note: tomLog methods return void, so we just verify they don't throw

# =============================================================================
# Test: TomLogLevel Static Values (6 tests)
# =============================================================================

var debugLevel = TomLogLevel.debug;
verifyNotNull(debugLevel, 'Debug level not null');
verifyEquals(debugLevel.levelPattern, 2, 'Debug level pattern is 2');

var infoLevel = TomLogLevel.info;
verifyEquals(infoLevel.levelPattern, 8, 'Info level pattern is 8');

var warnLevel = TomLogLevel.warn;
verifyEquals(warnLevel.levelPattern, 16, 'Warn level pattern is 16');

var errorLevel = TomLogLevel.error;
verifyEquals(errorLevel.levelPattern, 512, 'Error level pattern is 512');

var severeLevel = TomLogLevel.severe;
verifyEquals(severeLevel.levelPattern, 1024, 'Severe level pattern is 1024');

# =============================================================================
# Test: TomLogLevel Operations (4 tests)
# =============================================================================

var combined = TomLogLevel.debug + TomLogLevel.info;
verifyEquals(combined.levelPattern, 10, 'Combined debug+info is 10');

var combined2 = TomLogLevel.error + TomLogLevel.severe;
verifyEquals(combined2.levelPattern, 1536, 'Combined error+severe is 1536');

var allLevel = TomLogLevel.all;
verifyEquals(allLevel.levelPattern, 65535, 'All level pattern');

var noneLevel = TomLogLevel.none;
verifyEquals(noneLevel.levelPattern, 0, 'None level pattern is 0');

# =============================================================================
# Test: TomLogLevel byName / matches (3 tests)
# =============================================================================

verifyEquals(TomLogLevel.byName('info').levelPattern, 8, 'byName(info) resolves to info');
verify(TomLogLevel.all.matches(TomLogLevel.info), 'all matches info');
verifyEquals(TomLogLevel.trace.levelPattern, 1, 'Trace level pattern is 1');

# =============================================================================
# Test: TomPlatform Constants (9 tests)
# =============================================================================

verifyNotNull(platformMacos, 'macOS platform constant');
verifyNotNull(platformLinux, 'Linux platform constant');
verifyNotNull(platformWindows, 'Windows platform constant');
verifyNotNull(platformWeb, 'Web platform constant');
verifyNotNull(platformAndroid, 'Android platform constant');
verifyNotNull(platformIos, 'iOS platform constant');
verifyNotNull(noTomPlatform, 'No platform constant');
verifyEquals(platformLinux.name, 'linux', 'Linux platform name');
verifyEquals(platformMacos.name, 'macos', 'macOS platform name (lower-case id)');

# =============================================================================
# Test: TomEnvironment (3 tests)
# =============================================================================

var env = TomEnvironment('staging');
verifyEquals(env.env, 'staging', 'Environment name is staging');
verifyEquals(env.isTest, false, 'isTest defaults to false');
verifyEquals(env.isDevelopment, false, 'isDevelopment defaults to false');

# =============================================================================
# Test: TomBaseException (3 tests)
# =============================================================================

var ex = TomBaseException('err.boom', 'Something went boom');
verifyEquals(ex.key, 'err.boom', 'Exception key preserved');
verifyEquals(ex.defaultUserMessage, 'Something went boom', 'Exception user message preserved');
verifyNotNull(ex.uuid, 'Exception has a generated uuid');

# =============================================================================
# Test: limited() global function (3 tests)
# =============================================================================

verifyEquals(limited('abcdefghij', 4), 'abcd...', 'limited truncates long strings');
verifyEquals(limited('ab', 4), 'ab', 'limited leaves short strings untouched');
verifyEquals(limited(12345, 3), '123...', 'limited stringifies non-strings');

# =============================================================================
# Test: TomConsoleLogOutput (§46 zero-ref) (5 tests)
# =============================================================================

var consoleOut = TomConsoleLogOutput();
verifyNotNull(consoleOut, 'TomConsoleLogOutput constructed');
verifyNotNull(consoleOut.useExtendedFormat, 'useExtendedFormat getter returns a bool');
verifyNotNull(consoleOut.convertToString('hello'), 'convertToString produces a string');
consoleOut.useExtendedFormat = true;
verifyEquals(consoleOut.useExtendedFormat, true, 'useExtendedFormat setter round-trips');
# Static log-level settings round-trip through the bridge
TomConsoleLogOutput.globalSettingStdoutLogLevel = TomLogLevel.warn;
verifyEquals(TomConsoleLogOutput.globalSettingStdoutLogLevel.levelPattern, 16, 'stdout log level static round-trips');

# =============================================================================
# Test: TomLogOutput abstract statics (§46 zero-ref) (1 test)
# =============================================================================

# Abstract base: no constructor; exercise its static accessor pair.
TomLogOutput.globalSettingRemoteLogEndpoint = 'https://logs.example/ingest';
verifyEquals(TomLogOutput.globalSettingRemoteLogEndpoint, 'https://logs.example/ingest', 'remote log endpoint static round-trips');

# =============================================================================
# Test: TomPlatformUtils abstract statics (§46 zero-ref) (2 tests)
# =============================================================================

# Abstract base: no constructor; exercise its static accessors.
var currentPlatform = TomPlatformUtils.current;
verifyNotNull(currentPlatform, 'TomPlatformUtils.current resolves');
verifyNotNull(TomPlatformUtils.envVars, 'TomPlatformUtils.envVars map resolves');

# =============================================================================
# Test: TomFallbackPlatformUtils (§46 zero-ref) (1 test)
# =============================================================================

# This is a deliberate stub: its platform predicates throw UnimplementedError
# until a concrete platform is installed, so coverage is construction-only.
var fallbackPlatform = TomFallbackPlatformUtils();
verifyNotNull(fallbackPlatform, 'TomFallbackPlatformUtils constructed');

# =============================================================================
# Test: TomRuntime (§46 zero-ref) (4 tests)
# =============================================================================

var runtime = TomRuntime();
verifyNotNull(runtime, 'TomRuntime constructed');
verifyNotNull(TomRuntime.getEnvironments(), 'TomRuntime.getEnvironments returns a list');
verifyNotNull(TomRuntime.getPlatforms(), 'TomRuntime.getPlatforms returns a list');
verifyNotNull(TomRuntime.printReport(), 'TomRuntime.printReport returns a string');

# =============================================================================
# Test: TomLogger class surface (RCG5 — closes the last tom_basics gap) (20 tests)
# =============================================================================
# The `tomLog` global (tested above) is a TomLogger, but the CLASS itself was
# never constructed/exercised by name. Drive its full bridged surface here:
# static label constants, static enable flags, the level stack, per-name
# overrides, and every log method.

var logger = TomLogger();
verifyNotNull(logger, 'TomLogger constructed directly');

# Static level-name label constants (fixed-width 7-char labels)
verifyEquals(TomLogger.INFO, 'INFO   ', 'TomLogger.INFO label constant');
verifyEquals(TomLogger.ERROR, 'ERROR  ', 'TomLogger.ERROR label constant');
verifyEquals(TomLogger.SEVERE, 'SEVERE ', 'TomLogger.SEVERE label constant');
verifyEquals(TomLogger.TRAFFIC, 'TRAFFIC', 'TomLogger.TRAFFIC label constant');

# Static enable-flag setter/getter round-trips (restore to avoid side effects)
TomLogger.globalSettingInfoEnabled = false;
verifyEquals(TomLogger.globalSettingInfoEnabled, false, 'globalSettingInfoEnabled setter round-trips');
TomLogger.globalSettingInfoEnabled = true;
verifyEquals(TomLogger.globalSettingInfoEnabled, true, 'globalSettingInfoEnabled restored to true');
verifyNotNull(TomLogger.fallback, 'TomLogger.fallback static instance resolves');

# logLevel getter + setLogLevel (RCE6: current level IS the stack top)
logger.setLogLevel(TomLogLevel.warn);
verifyEquals(logger.logLevel.levelPattern, 16, 'setLogLevel makes warn the current level');

# setLogLevelByName resolves via TomLogLevel.byName (case-insensitive)
logger.setLogLevelByName('info');
verifyEquals(logger.logLevel.levelPattern, 8, 'setLogLevelByName(info) sets info as current level');

# push/pop level-stack bridge methods (RCE6 LIFO semantics). The current level
# is above at info=8; pushing trace makes trace current, and popping restores
# the pre-push level (info=8) — a true LIFO scope. This asserts the RCE6 fix,
# consumable here because tom_core_d4rt now resolves tom_basics >=1.0.1.
logger.pushLogLevel(TomLogLevel.trace);
verifyEquals(logger.logLevel.levelPattern, 1, 'pushLogLevel(trace) makes trace the current level');
logger.popLogLevel();
verifyEquals(logger.logLevel.levelPattern, 8, 'popLogLevel restores the pre-push level (info=8) — RCE6 LIFO');

# Per-name level overrides round-trip
logger.addNameLevel('MyService', TomLogLevel.debug);
verifyEquals(logger.getNameLevel('MyService').levelPattern, 2, 'addNameLevel/getNameLevel round-trip');
logger.removeNameLevel('MyService');
verifyEquals(logger.getNameLevel('MyService'), null, 'removeNameLevel clears the override');

# setLogLevelExceptions parses <name>=<level> pairs (uppercase level names)
logger.setLogLevelExceptions('DatabaseService=DEBUG,ApiClient=TRACE');
verifyEquals(logger.getNameLevel('ApiClient').levelPattern, 1, 'setLogLevelExceptions parses per-name TRACE');

# Every level method executes without throwing
logger.info('info via TomLogger instance');
logger.debug('debug message');
logger.warn('warn message');
logger.error('error message');
logger.trace('trace message');
logger.traffic('traffic message');
logger.severe('severe message');
logger.fatal('fatal message');
logger.status('status message');
verify(true, 'all TomLogger level methods executed without throwing');

# output(messageLogLevel, level, message) explicit call
logger.output(TomLogLevel.info, TomLogger.INFO, 'explicit output call');
verify(true, 'TomLogger.output executed');

# logOutput getter/setter round-trip
var loggerOut = TomConsoleLogOutput();
logger.logOutput = loggerOut;
verifyNotNull(logger.logOutput, 'logOutput getter returns the assigned output');

# toString
verifyNotNull(logger.toString(), 'TomLogger.toString produces a string');

# =============================================================================
# Note: TomLoggable (§46) is an abstract mixin with no constructor and no
# statics; its only member is the `logRepresentation` getter, which requires a
# concrete TomLoggable instance not constructable connection-free here. Its
# registration is still validated by bridge load; direct-member coverage is
# deferred (see deferred.tom_core.md).

# =============================================================================
# Summary
# =============================================================================

testSummary();
