# D4rt Test Suite - Tom Md2Pdf Classes
# Run with: d4rt test_d4rt_tom_md2pdf.d4rt -test
# Tests tom_md2pdf bridged classes (PDF options value model + converter carriers).
# NOTE: Uses single-line syntax for D4rt parser compatibility.


# =============================================================================
# Test: PageFormat enum (3 tests)
# =============================================================================

verifyEquals(PageFormat.values.length, 6, 'PageFormat has 6 values');
verifyEquals(PageFormat.a4.name, 'a4', 'PageFormat.a4 name');
verifyEquals(PageFormat.tabloid.name, 'tabloid', 'PageFormat.tabloid name');

# =============================================================================
# Test: PageMargins value carrier (6 tests)
# =============================================================================

var m = PageMargins();
verifyEquals(m.top, 72.0, 'PageMargins default top');
verifyEquals(m.left, 72.0, 'PageMargins default left');

var mAll = PageMargins.all(10.0);
verifyEquals(mAll.top, 10.0, 'PageMargins.all top');
verifyEquals(mAll.right, 10.0, 'PageMargins.all right');

var mSym = PageMargins.symmetric(horizontal: 5.0, vertical: 8.0);
verifyEquals(mSym.top, 8.0, 'PageMargins.symmetric vertical -> top');
verifyEquals(mSym.right, 5.0, 'PageMargins.symmetric horizontal -> right');

# =============================================================================
# Test: PdfConverterOptionsWrapper defaults + getters (4 tests)
# =============================================================================

var opts = PdfConverterOptionsWrapper();
verifyEquals(opts.pageFormat, 'a4', 'PdfConverterOptionsWrapper default pageFormat');
verifyEquals(opts.fontSize, 12.0, 'PdfConverterOptionsWrapper default fontSize');
verifyEquals(opts.fontFamily, 'Roboto', 'PdfConverterOptionsWrapper default fontFamily');

var opts2 = PdfConverterOptionsWrapper(title: 'Report', pageFormat: 'a5');
verifyEquals(opts2.title, 'Report', 'PdfConverterOptionsWrapper title');

# =============================================================================
# Test: Converter value carriers (3 tests)
# =============================================================================

var cf = PdfConvertedFile(sourcePath: 's.md', outputPath: 'o.pdf');
verifyEquals(cf.sourcePath, 's.md', 'PdfConvertedFile sourcePath');
verifyEquals(cf.outputPath, 'o.pdf', 'PdfConvertedFile outputPath');

var err = PdfConversionError(sourcePath: 'bad.md', message: 'boom');
verifyEquals(err.message, 'boom', 'PdfConversionError message');

# =============================================================================
# Test: Classes exist (3 tests)
# =============================================================================

verifyNotNull(Md2Pdf, 'Md2Pdf class exists');
verifyNotNull(MdPdfConverter, 'MdPdfConverter class exists');
verifyNotNull(MdPdfConverterOptions, 'MdPdfConverterOptions class exists');

# =============================================================================
# Summary
# =============================================================================

testSummary();
