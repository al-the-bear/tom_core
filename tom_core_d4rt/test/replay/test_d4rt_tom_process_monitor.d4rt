# D4rt Test Suite - Tom Process Monitor Classes
# Run with: d4rt test_d4rt_tom_process_monitor.d4rt -test
# Tests tom_process_monitor bridged classes
# NOTE: Uses single-line syntax for D4rt parser compatibility


# =============================================================================
# Test: ProcessConfig (requires id, name, command)
# =============================================================================

var config = ProcessConfig(id: 'proc-001', name: 'test_process', command: 'dart', args: ['run', 'server.dart']);
verifyNotNull(config, 'ProcessConfig created');
verifyEquals(config.id, 'proc-001', 'Config id');
verifyEquals(config.name, 'test_process', 'Config name');
verifyEquals(config.command, 'dart', 'Config command');
verifyEquals(config.args.length, 2, 'Config args count');
verifyEquals(config.autostart, true, 'Config autostart default');

var config2 = ProcessConfig(id: 'proc-002', name: 'bg_task', command: 'node', workingDirectory: '/app');
verifyEquals(config2.workingDirectory, '/app', 'Config workingDirectory');

# =============================================================================
# Test: ProcessEntry (requires id, name, command, registeredAt)
# =============================================================================

var entry = ProcessEntry(id: 'entry-001', name: 'web_server', command: 'dart', registeredAt: DateTime.now());
verifyNotNull(entry, 'ProcessEntry created');
verifyEquals(entry.id, 'entry-001', 'Entry id');
verifyEquals(entry.name, 'web_server', 'Entry name');
verifyEquals(entry.command, 'dart', 'Entry command');
verifyEquals(entry.state, ProcessState.stopped, 'Entry default state');
verifyEquals(entry.enabled, true, 'Entry enabled default');
verifyEquals(entry.autostart, true, 'Entry autostart default');

# =============================================================================
# Test: ProcessState Enum
# =============================================================================

verifyNotNull(ProcessState.running, 'ProcessState.running');
verifyNotNull(ProcessState.stopped, 'ProcessState.stopped');
verifyNotNull(ProcessState.failed, 'ProcessState.failed');
verifyNotNull(ProcessState.starting, 'ProcessState.starting');
verifyNotNull(ProcessState.stopping, 'ProcessState.stopping');
verifyNotNull(ProcessState.crashed, 'ProcessState.crashed');
verifyNotNull(ProcessState.retrying, 'ProcessState.retrying');
verifyNotNull(ProcessState.disabled, 'ProcessState.disabled');
verifyEquals(ProcessState.running.name, 'running', 'ProcessState.running name');
verifyEquals(ProcessState.values.length, 8, 'ProcessState has 8 values');

# =============================================================================
# Test: RestartPolicy (all optional with defaults)
# =============================================================================

var policy = RestartPolicy();
verifyNotNull(policy, 'RestartPolicy created with defaults');
verifyEquals(policy.maxAttempts, 5, 'Policy default maxAttempts');
verifyNotNull(policy.backoffIntervalsMs, 'Policy backoffIntervalsMs');
verifyEquals(policy.retryIndefinitely, false, 'Policy default retryIndefinitely');

verifyNotNull(RestartPolicy.defaultPolicy, 'RestartPolicy.defaultPolicy');

var customPolicy = RestartPolicy(maxAttempts: 10, retryIndefinitely: true);
verifyEquals(customPolicy.maxAttempts, 10, 'Custom policy maxAttempts');
verifyEquals(customPolicy.retryIndefinitely, true, 'Custom policy retryIndefinitely');

# =============================================================================
# Test: AlivenessCheck (requires enabled and url)
# =============================================================================

var aliveCheck = AlivenessCheck(enabled: true, url: 'http://localhost:8080/health');
verifyNotNull(aliveCheck, 'AlivenessCheck created');
verifyEquals(aliveCheck.enabled, true, 'AlivenessCheck enabled');
verifyEquals(aliveCheck.url, 'http://localhost:8080/health', 'AlivenessCheck url');
verifyEquals(aliveCheck.intervalMs, 3000, 'AlivenessCheck default intervalMs');
verifyEquals(aliveCheck.timeoutMs, 2000, 'AlivenessCheck default timeoutMs');
verifyEquals(aliveCheck.consecutiveFailuresRequired, 2, 'AlivenessCheck default failures');

var disabledCheck = AlivenessCheck(enabled: false, url: '');
verifyEquals(disabledCheck.enabled, false, 'Disabled AlivenessCheck');

# =============================================================================
# Test: StartupCheck
# =============================================================================

var startupCheck = StartupCheck(maxAttempts: 50, initialDelayMs: 5000);
verifyNotNull(startupCheck, 'StartupCheck created');
verifyEquals(startupCheck.maxAttempts, 50, 'StartupCheck maxAttempts');
verifyEquals(startupCheck.initialDelayMs, 5000, 'StartupCheck initialDelayMs');

# =============================================================================
# Test: Exception Classes
# =============================================================================

var pmEx = ProcessMonitorException('Process monitor error');
verifyNotNull(pmEx, 'ProcessMonitorException created');
verifyEquals(pmEx.message, 'Process monitor error', 'Exception message');

var lockEx = LockTimeoutException('Lock acquisition timed out');
verifyNotNull(lockEx, 'LockTimeoutException created');

var notFoundEx = ProcessNotFoundException('Process not found');
verifyNotNull(notFoundEx, 'ProcessNotFoundException created');

var disabledEx = ProcessDisabledException('Process is disabled');
verifyNotNull(disabledEx, 'ProcessDisabledException created');

var permEx = PermissionDeniedException('Permission denied');
verifyNotNull(permEx, 'PermissionDeniedException created');

# =============================================================================
# Test: Networking re-exports (tom_basics_network)
# =============================================================================

var rc = RetryConfig();
verifyEquals(rc.retryDelaysMs.length, 5, 'RetryConfig default delays length');
verifyEquals(kDefaultRetryDelaysMs.length, 5, 'kDefaultRetryDelaysMs length');
verifyEquals(kDefaultRetryDelaysMs[0], 2000, 'kDefaultRetryDelaysMs first delay');

var ds = DiscoveredServer(serverUrl: 'http://localhost:8080', status: {'service': 'pm', 'port': 8080});
verifyEquals(ds.serverUrl, 'http://localhost:8080', 'DiscoveredServer serverUrl');
verifyEquals(ds.service, 'pm', 'DiscoveredServer service getter');
verifyEquals(ds.port, 8080, 'DiscoveredServer port getter');

# =============================================================================
# Test: ProcessStatus (status snapshot value carrier)
# =============================================================================

var status = ProcessStatus(id: 'p1', name: 'web', state: ProcessState.running, enabled: true, autostart: true, isRemote: false);
verifyNotNull(status, 'ProcessStatus created');
verifyEquals(status.id, 'p1', 'ProcessStatus id');
verifyEquals(status.state, ProcessState.running, 'ProcessStatus state');
verifyEquals(status.restartAttempts, 0, 'ProcessStatus default restartAttempts');
verifyNotNull(status.toJson(), 'ProcessStatus toJson');

# =============================================================================
# Test: MonitorStatus (monitor snapshot value carrier)
# =============================================================================

var monStatus = MonitorStatus(instanceId: 'm1', pid: 4321, startedAt: DateTime.now(), uptime: 1000, state: 'running', standaloneMode: true, managedProcessCount: 3, runningProcessCount: 2);
verifyNotNull(monStatus, 'MonitorStatus created');
verifyEquals(monStatus.instanceId, 'm1', 'MonitorStatus instanceId');
verifyEquals(monStatus.managedProcessCount, 3, 'MonitorStatus managedProcessCount');

# =============================================================================
# Test: RemoteAccessConfig (all-default config value carrier)
# =============================================================================

var remoteCfg = RemoteAccessConfig();
verifyNotNull(remoteCfg, 'RemoteAccessConfig created with defaults');
verifyEquals(remoteCfg.startRemoteAccess, false, 'RemoteAccessConfig default startRemoteAccess');
verifyEquals(remoteCfg.remotePort, 19881, 'RemoteAccessConfig default remotePort');
verifyEquals(remoteCfg.allowRemoteRegister, true, 'RemoteAccessConfig default allowRemoteRegister');
verifyNotNull(RemoteAccessConfig.defaultConfig, 'RemoteAccessConfig.defaultConfig static');

# =============================================================================
# Test: PartnerDiscoveryConfig (config value carrier + static factory)
# =============================================================================

var partnerCfg = PartnerDiscoveryConfig();
verifyNotNull(partnerCfg, 'PartnerDiscoveryConfig created with defaults');
verifyEquals(partnerCfg.discoveryOnStartup, true, 'PartnerDiscoveryConfig default discoveryOnStartup');
var partnerCfg2 = PartnerDiscoveryConfig.defaultForInstance('inst-1');
verifyNotNull(partnerCfg2, 'PartnerDiscoveryConfig.defaultForInstance');

# =============================================================================
# Test: AlivenessServerConfig (config value carrier)
# =============================================================================

var aliveCfg = AlivenessServerConfig();
verifyEquals(aliveCfg.enabled, true, 'AlivenessServerConfig default enabled');
verifyEquals(aliveCfg.port, 19883, 'AlivenessServerConfig default port');

# =============================================================================
# Test: WatcherInfo (value carrier)
# =============================================================================

var watcher = WatcherInfo(watcherPid: 99, watcherInstanceId: 'w1', watcherAlivenessPort: 19884);
verifyEquals(watcher.watcherPid, 99, 'WatcherInfo watcherPid');
verifyEquals(watcher.watcherInstanceId, 'w1', 'WatcherInfo watcherInstanceId');

# =============================================================================
# Test: LockInfo (lock metadata value carrier)
# =============================================================================

var lockInfo = LockInfo(lockedBy: 'inst-1', lockedAt: DateTime.now(), pid: 1234, operation: 'register');
verifyEquals(lockInfo.lockedBy, 'inst-1', 'LockInfo lockedBy');
verifyEquals(lockInfo.operation, 'register', 'LockInfo operation');

# =============================================================================
# Test: RegistryLock (construct + getters; withLock is IO, not driven)
# =============================================================================

var regLock = RegistryLock(lockPath: '/tmp/reg.lock', instanceId: 'inst-1');
verifyEquals(regLock.lockPath, '/tmp/reg.lock', 'RegistryLock lockPath');
verifyEquals(regLock.instanceId, 'inst-1', 'RegistryLock instanceId');

# =============================================================================
# Test: DiscoveryOptions + exceptions (tom_basics_network re-exports)
# =============================================================================

var discOpts = DiscoveryOptions();
verifyEquals(discOpts.port, 19880, 'DiscoveryOptions default port');
verifyEquals(discOpts.scanSubnet, true, 'DiscoveryOptions default scanSubnet');

var retryExhausted = RetryExhaustedException(lastError: 'boom', attempts: 3);
verifyEquals(retryExhausted.attempts, 3, 'RetryExhaustedException attempts');
verifyEquals(retryExhausted.lastError, 'boom', 'RetryExhaustedException lastError');

var discFailed = DiscoveryFailedException('no server found');
verifyEquals(discFailed.message, 'no server found', 'DiscoveryFailedException message');

# =============================================================================
# Test: Runtime entry points exist (integration-only: scan/serve/spawn IO)
# =============================================================================

verifyNotNull(ProcessRegistry, 'ProcessRegistry class exists');
verifyNotNull(RegistryService, 'RegistryService class exists');
verifyNotNull(ProcessControl, 'ProcessControl class exists');
verifyNotNull(ProcessMonitor, 'ProcessMonitor class exists');
verifyNotNull(LocalProcessMonitorClient, 'LocalProcessMonitorClient class exists');
verifyNotNull(RemoteProcessMonitorClient, 'RemoteProcessMonitorClient class exists');
verifyNotNull(ServerDiscovery, 'ServerDiscovery class exists');

# =============================================================================
# Summary
# =============================================================================

testSummary();
