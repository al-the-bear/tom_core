# Copy to `.env` and adjust. Every variable below is read by something: the
# compose file, the datasource loader (assets/datasources_default.yaml, via
# ${VAR:default}), or — for `env` — the boot's TomRuntime.setCurrentEnvironment.

# Which MariaDB image the compose `db` service runs.
TODO_DB_DOCKER_IMAGE=mariadb:11

# Connection coordinates. TODO_DB_HOST is `localhost` when you run the server
# on the host against the published port, or `db` when the server runs inside
# the compose network.
TODO_DB_HOST=localhost
TODO_DB_PORT=3306
TODO_DB_NAME=todo_db
TODO_DB_USER=app
TODO_DB_PASSWORD=app
TODO_DB_ROOT_PASSWORD=password

# The HTTP port is deliberately NOT a variable: it is the `_defaultPort`
# constant in bin/server_start.dart, overridden with the `port` config key or
# `--port=`.

# Runtime environment selector (prod | int | dev). Picks the matching
# assets/config-resources_<env>.yaml overlay.
env=dev
