# Copy to `.env` and adjust. Every variable below is read by something, but not
# all of them by the same thing — the comments say which, because "read by the
# compose file and the server" is true of only four of the seven TODO_DB_*
# variables. There are three routes out of this file:
#
#   1. Docker Compose reads it natively, for the `db` service.
#   2. The server expands ${VAR:default} placeholders in assets/*.yaml from it.
#      It has to be handed the file to do that, because Dart's process
#      environment is read-only: bin/server_start.dart resolves it once, at
#      `_environment = TomEnvFile.resolveEnvironment()`, and passes the result
#      to every TomYaml.loadYamlFile call. So editing a value here moves the
#      database the server dials as well as the one Compose starts.
#   3. TomBaseServerConfiguration merges the whole file into the CONFIGURATION
#      keys, so any line naming a configuration field sets it directly — see
#      `port` below. No placeholder, no asset.
#
# `env` takes a fourth path of its own: the boot reads it out of the resolved
# map and hands it to TomRuntime.setCurrentEnvironment.
#
# One difference worth knowing: if a variable is set in your shell *and* here,
# Compose takes the shell's value and the server takes this file's. Set it in
# one place.

# Which MariaDB image the compose `db` service runs.
TODO_DB_DOCKER_IMAGE=mariadb:11

# Connection coordinates — read by both consumers, except TODO_DB_HOST, which
# only the server uses (Compose always reaches the service at its own published
# port). TODO_DB_HOST is `localhost` when you run the server on the host against
# that published port, or `db` when the server runs inside the compose network.
TODO_DB_HOST=localhost
TODO_DB_PORT=3306
TODO_DB_NAME=todo_db
TODO_DB_USER=app
TODO_DB_PASSWORD=app

# Compose only: the root password MariaDB initializes itself with. This is not a
# connection coordinate — the server connects as TODO_DB_USER above and never as
# root.
TODO_DB_ROOT_PASSWORD=password

# There is no TODO_SERVER_PORT, but that does not put the HTTP port out of this
# file's reach — it just takes route 3 above. The port is the `port`
# CONFIGURATION key (8080 by default, from the `_defaultPort` constant in
# bin/server_start.dart, applied only where the merge left it at 0). So set it
# as a plain key, not a ${...} placeholder, and with no asset to edit:
#port=9000
# The command line uses the same key and wins over this file — spelled
# `port=9000`, UNDASHED. `--port=9000` fills a key named `--port`, which matches
# no field and is dropped silently.

# Runtime environment selector (prod | int | dev). Picks the matching
# assets/config-resources_<env>.yaml overlay.
env=dev
