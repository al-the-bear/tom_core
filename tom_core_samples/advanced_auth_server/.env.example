# Copy to `.env` and adjust. Every variable below is read by something: the
# compose file, the datasource loader the boot wires up
# (assets/datasources_default.yaml, via ${VAR:default}), or — for `env` — the
# boot's TomRuntime.setCurrentEnvironment.

# Which MariaDB image the compose `auth-db` service runs.
AUTH_DB_DOCKER_IMAGE=mariadb:11

# Connection coordinates. AUTH_DB_HOST is `localhost` when you run the server on
# the host against the published port, or `auth-db` when the server runs inside
# the compose network. The default published port is 3307 so auth_db and the
# app server's app_db do not collide on one host.
AUTH_DB_HOST=localhost
AUTH_DB_PORT=3307
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth
AUTH_DB_ROOT_PASSWORD=password

# There is no AUTH_SERVER_PORT placeholder, but that does not put the HTTP port
# out of this file's reach. The port is the `port` CONFIGURATION key (8081 by
# default, from the `_defaultPort` constant in bin/auth_server_start.dart,
# applied only where the merge left it at 0), so set it as a plain key rather
# than a ${...} placeholder. Keep it clear of the app server's 8080:
#port=9081
# The command line uses the same key and wins over this file — spelled
# `port=9081`, UNDASHED. `--port=9081` fills a key named `--port`, which matches
# no field and is dropped silently.

# The JWT keys are deliberately NOT variables: signing uses the framework's
# bundled sample keypair installed by initializeJwtSigning(). There is no shared
# signing secret to set here — to run against real keys, build a
# TomJwtConfiguration with `isDummy: false` (see the README's "JWT signing"
# section).

# Runtime environment selector (prod | int | dev). Picks the matching
# assets/config-resources_<env>.yaml overlay.
env=dev
