# Copy to `.env` and adjust. Every variable below is read by something: the
# compose file, the datasource loader the boot wires up
# (assets/datasources_default.yaml, via ${VAR:default}), or — for `env` — the
# boot's TomRuntime.setCurrentEnvironment.

# Which MariaDB image the compose `auth-db` service runs.
AUTH_DB_DOCKER_IMAGE=mariadb:11

# Connection coordinates. AUTH_DB_HOST is `localhost` when you run the server on
# the host against the published port, or `auth-db` when the server runs inside
# the compose network. The default published port is 3307 so auth_db and the
# app server's app_db do not collide on one host.
AUTH_DB_HOST=localhost
AUTH_DB_PORT=3307
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth
AUTH_DB_ROOT_PASSWORD=password

# There is no AUTH_SERVER_PORT placeholder, but that does not put the HTTP port
# out of this file's reach. The port is the `port` CONFIGURATION key (8081 by
# default, from the `_defaultPort` constant in bin/auth_server_start.dart,
# applied only where the merge left it at 0), so set it as a plain key rather
# than a ${...} placeholder. Keep it clear of the app server's 8080:
#port=9081
# The command line uses the same key and wins over this file. `--port=9081`,
# `-port=9081` and `port=9081` all set it: TomArgs strips the leading dashes from
# a command-line key. This file does not — write the key here as `port`.

# Token signing. This server ISSUES tokens: it signs them RS256 (the default
# JWT_ALGORITHM) with the private key in JWT_SIGNING_KEY_FILE and publishes the
# public half at GET /.well-known/jwks.json. advanced_app_server verifies them
# with that public half, named in its JWT_VERIFICATION_KEY_FILES. Each variable
# reaches the configuration field it spells (`jwtSigningKeyFile`, ...).
#
# Left commented out, both servers fall back to the framework's bundled sample
# RSA pair — which is published in the tom_crypto sources and secret from
# nobody. `installJwtSigning` warns about it at boot and permits it only because
# `env=dev` below selects a development environment; under `env=prod` the boot
# refuses to start until a key is configured.
#
# To watch it work: generate a pair (PKCS#8 private key, SPKI public key), set
# JWT_SIGNING_KEY_FILE here and JWT_VERIFICATION_KEY_FILES to the PUBLIC key in
# advanced_app_server/.env. The app server then verifies this server's tokens
# and can mint none of its own.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#   openssl pkey -in jwt.pem -pubout -out jwt.pub.pem
#JWT_SIGNING_KEY_FILE=/path/to/jwt.pem
#
# The issuer and audience every token carries. The app server requires the
# SAME values; change one in one server only and it rejects this one's tokens.
#JWT_ISSUER=tom
#JWT_AUDIENCE=advanced-todo
#
# JWT_ALGORITHM=ES256 signs with an EC P-256 key instead. JWT_ALGORITHM=HS256
# signs with the shared secret JWT_SHARED_SECRET_KEY, which both servers then
# hold; it is read under no other algorithm, and nothing is published.
#JWT_ALGORITHM=RS256
#JWT_SHARED_SECRET_KEY=change-me-in-production

# The RSA pair that encrypts the access-control payload inside the token, under
# every algorithm — same rules, same fallback, and the same pair in both
# servers, since both read that payload. This file is read a line at a time, so
# a PEM goes on ONE line with its newlines written as spaces; the parser strips
# spaces and newlines alike, so the value is the same key.
#JWT_RSA_PRIV_KEY=-----BEGIN RSA PRIVATE KEY----- MIIE... -----END RSA PRIVATE KEY-----
#JWT_RSA_PUB_KEY=-----BEGIN PUBLIC KEY----- MIIB... -----END PUBLIC KEY-----

# Runtime environment selector (prod | int | dev). Picks the matching
# assets/config-resources_<env>.yaml overlay.
env=dev
