# Copy to `.env` and adjust. Consumed by docker-compose.yaml and, at runtime, by
# the datasource loader wired in the boot (step 21) via ${VAR:default}.

# Which MariaDB image the compose `app-db` service runs.
APP_DB_DOCKER_IMAGE=mariadb:11

# Connection coordinates. APP_DB_HOST is `localhost` when you run the server on
# the host against the published port, or `app-db` when the server runs inside
# the compose network. The default published port is 3308 so app_db and the
# auth server's auth_db (3307) do not collide on one host.
APP_DB_HOST=localhost
APP_DB_PORT=3308
APP_DB_NAME=app_db
APP_DB_USER=app
APP_DB_PASSWORD=app
APP_DB_ROOT_PASSWORD=password

# HTTP port the app server binds. 8080 is left free for it (the auth server
# binds 8081).
APP_SERVER_PORT=8080

# Where the app server reaches the auth server to verify tokens / resolve users.
AUTH_SERVER_URL=http://localhost:8081

# Shared JWT signing secret. The app server must trust the SAME key the auth
# server signs with, so a token the auth server mints is accepted here.
AUTH_JWT_SECRET=change-me-in-production

# Runtime environment selector (prod | int | dev). Picks the matching
# assets/config-resources_<env>.yaml overlay.
env=dev
