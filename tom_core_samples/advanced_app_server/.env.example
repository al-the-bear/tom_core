# Copy to `.env` and adjust. Every variable below is read by something: the
# compose file, the datasource loader wired in the boot (step 21, via
# ${VAR:default}), or — for `env` — the boot's TomRuntime.setCurrentEnvironment.

# Which MariaDB image the compose `app-db` service runs.
APP_DB_DOCKER_IMAGE=mariadb:11

# Connection coordinates. APP_DB_HOST is `localhost` when you run the server on
# the host against the published port, or `app-db` when the server runs inside
# the compose network. The default published port is 3308 so app_db and the
# auth server's auth_db (3307) do not collide on one host.
APP_DB_HOST=localhost
APP_DB_PORT=3308
APP_DB_NAME=app_db
APP_DB_USER=app
APP_DB_PASSWORD=app
APP_DB_ROOT_PASSWORD=password

# The HTTP port, the auth server's address and the JWT keys are deliberately NOT
# variables. The port is the `_defaultPort` constant in bin/app_server_start.dart
# (8080, leaving 8081 to the auth server), overridden with `--port=`. This server
# never calls the auth server over HTTP — it reads `auth_db` directly, via the
# second datasource block in assets/datasources_default.yaml — so there is no
# auth-server URL to configure. Signing uses the framework's bundled sample
# keypair, the same one the auth server installs, which is why a token minted
# there verifies here; there is no shared secret to keep in step.

# Runtime environment selector (prod | int | dev). Picks the matching
# assets/config-resources_<env>.yaml overlay.
env=dev
