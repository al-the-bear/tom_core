# Copy to `.env` and adjust. Every variable below is read by something: the
# compose file, the datasource loader wired in the boot (step 21, via
# ${VAR:default}), or — for `env` — the boot's TomRuntime.setCurrentEnvironment.

# Which MariaDB image the compose `app-db` service runs.
APP_DB_DOCKER_IMAGE=mariadb:11

# Connection coordinates. APP_DB_HOST is `localhost` when you run the server on
# the host against the published port, or `app-db` when the server runs inside
# the compose network. The default published port is 3308 so app_db and the
# auth server's auth_db (3307) do not collide on one host.
APP_DB_HOST=localhost
APP_DB_PORT=3308
APP_DB_NAME=app_db
APP_DB_USER=app
APP_DB_PASSWORD=app
APP_DB_ROOT_PASSWORD=password

# There is no APP_SERVER_PORT placeholder, but that does not put the HTTP port
# out of this file's reach. The port is the `port` CONFIGURATION key (8080 by
# default, from the `_defaultPort` constant in bin/app_server_start.dart, applied
# only where the merge left it at 0), so set it as a plain key rather than a
# ${...} placeholder. Keep it clear of the auth server's 8081:
#port=9080
# The command line uses the same key and wins over this file — spelled
# `port=9080`, UNDASHED. `--port=9080` fills a key named `--port`, which matches
# no field and is dropped silently.

# The auth server's address is deliberately NOT a variable: this server never
# calls the auth server over HTTP — it reads `auth_db` directly, via the second
# datasource block in assets/datasources_default.yaml — so there is no
# auth-server URL to configure.

# Token verification. This server VERIFIES the tokens advanced_auth_server
# issues and issues none: JWT_VERIFICATION_KEY_FILES names the auth server's
# PUBLIC key (comma-separated, to hold a retired key through a rotation), and
# with no JWT_SIGNING_KEY_FILE the server is verify-only. Each variable reaches
# the configuration field it spells (`jwtVerificationKeyFiles`, ...).
#
# Left commented out, both servers fall back to the framework's bundled sample
# RSA pair — which is published in the tom_crypto sources and secret from
# nobody. `installJwtSigning` warns about it at boot and permits it only because
# `env=dev` below selects a development environment; under `env=prod` the boot
# refuses to start until a key is configured.
#
# To watch it work: set JWT_SIGNING_KEY_FILE in advanced_auth_server/.env and
# the matching public key here.
#JWT_VERIFICATION_KEY_FILES=/path/to/jwt.pub.pem
#
# The issuer and audience a token must carry — the SAME values as the auth
# server's; a token naming another is rejected with `invalid token`.
#JWT_ISSUER=tom
#JWT_AUDIENCE=advanced-todo
#
# The algorithm must match the auth server's. Under JWT_ALGORITHM=HS256 both
# servers hold the same JWT_SHARED_SECRET_KEY instead of key files; it is read
# under no other algorithm.
#JWT_ALGORITHM=RS256
#JWT_SHARED_SECRET_KEY=change-me-in-production

# The RSA pair that encrypts the access-control payload inside the token, under
# every algorithm — same rules, same fallback, and the same pair in both
# servers, since both read that payload. This file is read a line at a time, so
# a PEM goes on ONE line with its newlines written as spaces; the parser strips
# spaces and newlines alike, so the value is the same key.
#JWT_RSA_PRIV_KEY=-----BEGIN RSA PRIVATE KEY----- MIIE... -----END RSA PRIVATE KEY-----
#JWT_RSA_PUB_KEY=-----BEGIN PUBLIC KEY----- MIIB... -----END PUBLIC KEY-----

# Runtime environment selector (prod | int | dev). Picks the matching
# assets/config-resources_<env>.yaml overlay.
env=dev
